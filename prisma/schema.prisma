// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum ShippingCompanyStatus {
  ACTIVE
  INACTIVE
}

enum PermissionType {
  MENU
  ACTION
  DATA
}

enum DataAccessLevel {
  VIEW_OWN // ดูได้เฉพาะตัวเอง
  VIEW_TEAM // ดูได้เฉพาะทีมเดียวกัน
  VIEW_DEPARTMENT // ดูได้เฉพาะแผนกเดียวกัน
  VIEW_ALL // ดูได้ทั้งหมด
}

enum EditAccessLevel {
  EDIT_NONE // ไม่สามารถแก้ไขได้
  EDIT_OWN // แก้ไขได้เฉพาะของตัวเอง
  EDIT_TEAM // แก้ไขได้เฉพาะทีมเดียวกัน
  EDIT_DEPARTMENT // แก้ไขได้เฉพาะของแผนกตัวเอง
  EDIT_ALL // แก้ไขได้ทั้งหมด
}

enum DeleteAccessLevel {
  DELETE_NONE // ไม่สามารถลบได้
  DELETE_OWN // ลบได้เฉพาะของตัวเอง
  DELETE_TEAM // ลบได้เฉพาะทีมเดียวกัน
  DELETE_DEPARTMENT // ลบได้เฉพาะของแผนกตัวเอง
  DELETE_ALL // ลบได้ทั้งหมด
}

enum CustomerType {
  DEALER
  SUBDEALER
  FARMER
  BROKER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CreditLimitStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum TemporaryCreditStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum PromotionalBudgetType {
  SALES_PROMOTION // ส่งเสริมการขาย
  MARKETING // ส่งเสริมการตลาด
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  password     String
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  departmentId String?
  positionId   String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department                     Department?              @relation("DepartmentUsers", fields: [departmentId], references: [id], onDelete: SetNull)
  position                       Position?                @relation("UserPosition", fields: [positionId], references: [id], onDelete: SetNull)
  employeeProfile                Employee?                @relation("UserEmployeeProfile")
  userRoles                      UserRole[]
  permissionOverrides            UserPermissionOverride[]
  requestedTemporaryCreditLimits TemporaryCreditLimit[]   @relation("TemporaryCreditRequester")
  approvedTemporaryCreditLimits  TemporaryCreditLimit[]   @relation("TemporaryCreditApprover")
  createdSales                   Sale[]                   @relation("SaleCreator")
  approvedSales                  Sale[]                   @relation("SaleApprover")
  saleStatusChanges              SaleStatusHistory[]      @relation("StatusHistoryUser")
  createdShipments               Shipment[]               @relation("ShipmentCreator") // Split Shipment\r\n
  // Logging relations
  auditLogs                      AuditLog[]               @relation("AuditLogUser")
  securityLogs                   SecurityLog[]            @relation("SecurityLogUser")
  targetedSecurityLogs           SecurityLog[]            @relation("SecurityLogTargetUser") // Existing
  notifications                  Notification[]           @relation("UserNotifications")
  salesTargetHistories           SalesTargetHistory[]     @relation("SalesTargetHistoryUser")
  activityPlans                  ActivityPlan[]           @relation("UserActivityPlans")
  activityApprovalLogs           ActivityApprovalLog[]    @relation("UserActivityApprovalLogs")
  activityResults                ActivityResult[]         @relation("UserActivityResults")
}

model Company {
  id          String        @id @default(cuid())
  name        String
  companyCode String?       @unique @map("company_code")
  shortName   String?       @map("short_name")
  email       String?       @unique
  phone       String?
  taxId       String?       @map("tax_id")
  addressLine String?       @map("address_line")
  province    String?
  district    String?
  subdistrict String?
  postalCode  String?
  status      CompanyStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  employees     Employee[]
  salesAsPickup Sale[]     @relation("SalePickupCompany")
}

model Employee {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  // Extended employee fields
  prefix             String?
  firstName          String?
  lastName           String?
  nickname           String?
  employeeCode       String?
  birthDate          DateTime?
  addressLine        String?   @map("address_line")
  province           String?
  district           String?
  subdistrict        String?
  postalCode         String?
  responsibilityArea String?
  status             String?
  positionTitle      String?
  departmentName     String?
  roleTitle          String?
  phone              String?
  signature          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  userId       String? @unique
  companyId    String?
  departmentId String?
  positionId   String?
  managerId    String?

  user                 User?                  @relation("UserEmployeeProfile", fields: [userId], references: [id], onDelete: SetNull)
  company              Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  department           Department?            @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  position             Position?              @relation("EmployeePosition", fields: [positionId], references: [id], onDelete: SetNull)
  reports              Employee[]             @relation("EmployeeHierarchy")
  manager              Employee?              @relation("EmployeeHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  responsibleCustomers Customer[]             @relation("EmployeeResponsible")
  sales                Sale[]                 @relation("SaleEmployee")
  salesTargets         SalesTarget[]
  pointSummary         EmployeePointSummary?
  pointHistories       EmployeePointHistory[]
  activityPlans        ActivityPlan[]         @relation("EmployeeActivityPlans")
  activityApprovals    ActivityPlan[]         @relation("EmployeeActivityApprovals")
  helperActivities     ActivityHelper[]       @relation("EmployeeActivityHelpers")
  approvedHelpers      ActivityHelper[]       @relation("EmployeeApprovedHelpers")
}

model Department {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  positions Position[]
  employees Employee[] @relation("EmployeeDepartment")
  users     User[]     @relation("DepartmentUsers")
}

model Position {
  id            String    @id @default(cuid())
  name          String
  description   String?
  level         Int       @default(1)
  isManagerial  Boolean   @default(false)
  departmentId  String?
  defaultRoleId String?
  deletedAt     DateTime?

  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  defaultRole Role?       @relation("RoleDefaultPositions", fields: [defaultRoleId], references: [id], onDelete: SetNull)
  employees   Employee[]  @relation("EmployeePosition")
  users       User[]      @relation("UserPosition")
}

model Role {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  permissions      RolePermission[]
  userRoles        UserRole[]
  defaultPositions Position[]       @relation("RoleDefaultPositions")
}

model Permission {
  id                  String             @id @default(cuid())
  key                 String             @unique
  name                String
  description         String?
  category            PermissionType
  menuPath            String?
  action              String?
  resource            String?
  defaultDataAccess   DataAccessLevel?
  defaultEditAccess   EditAccessLevel? // ขอบเขตการแก้ไขเริ่มต้น
  defaultDeleteAccess DeleteAccessLevel? // ขอบเขตการลบเริ่มต้น
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  rolePermissions RolePermission[]
  overrides       UserPermissionOverride[]
}

model RolePermission {
  id           String             @id @default(cuid())
  roleId       String
  permissionId String
  allow        Boolean            @default(true)
  dataAccess   DataAccessLevel? // ขอบเขตการมองเห็น
  editAccess   EditAccessLevel? // ขอบเขตการแก้ไข
  deleteAccess DeleteAccessLevel? // ขอบเขตการลบ
  createdAt    DateTime           @default(now())
  deletedAt    DateTime?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id         String    @id @default(cuid())
  userId     String
  roleId     String
  assignedBy String?
  assignedAt DateTime  @default(now())
  deletedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model UserPermissionOverride {
  id           String             @id @default(cuid())
  userId       String
  permissionId String
  allow        Boolean
  dataAccess   DataAccessLevel? // ขอบเขตการมองเห็น (override)
  editAccess   EditAccessLevel? // ขอบเขตการแก้ไข (override)
  deleteAccess DeleteAccessLevel? // ขอบเขตการลบ (override)
  reason       String?
  createdAt    DateTime           @default(now())
  deletedAt    DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model Customer {
  id                    String         @id @default(cuid())
  customerCode          String         @unique
  customerType          CustomerType
  name                  String
  prefix                String?
  firstName             String?
  birthDate             DateTime?
  lastName              String?
  email                 String?
  phone                 String?
  taxId                 String?        @map("tax_id")
  addressLine           String?        @map("address_line")
  province              String?
  region                String? // เก็บภาคของลูกค้า (เหนือ, กลาง, etc.)
  district              String?
  subdistrict           String?
  postalCode            String?        @map("postal_code")
  billingAddressLine    String?        @map("billing_address_line")
  billingProvince       String?        @map("billing_province")
  billingDistrict       String?        @map("billing_district")
  billingSubdistrict    String?        @map("billing_subdistrict")
  billingPostalCode     String?        @map("billing_postal_code")
  shippingAddressLine   String?        @map("shipping_address_line")
  shippingProvince      String?        @map("shipping_province")
  shippingDistrict      String?        @map("shipping_district")
  shippingSubdistrict   String?        @map("shipping_subdistrict")
  shippingPostalCode    String?        @map("shipping_postal_code")
  status                CustomerStatus @default(ACTIVE)
  contactPerson         String?        @map("contact_person")
  contactPhone          String?        @map("contact_phone")
  contactEmail          String?        @map("contact_email")
  notes                 String?
  latitude              String?
  longitude             String?
  relationshipScore     Int?
  parentDealerId        String?
  responsibleEmployeeId String?

  // SUBDEALER specific fields
  receiveFromDealer      String?
  mainCompetitor         String?
  areaCrops              String?
  averageMonthlyPurchase String?
  mainProductSold        String[]
  brandsSold             String[]
  areaType               String?

  // FARMER specific fields - stored as JSON
  farmPlots Json?

  // BROKER specific fields
  cropTypes             String?
  currentYield          String?
  farmerCount           String?
  plotCount             String?
  totalAreaRai          String?
  harvestPerYear        String?
  creditDays            String?
  chemicalValuePerCycle String?
  chemicalQtyPerCycle   String?
  regularShops          String?
  serviceTypes          String?
  usedBrands            String?

  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  images                CustomerImage[]
  creditLimits          CreditLimit[]
  temporaryCreditLimits TemporaryCreditLimit[]
  parentDealer          Customer?                 @relation("ParentDealer", fields: [parentDealerId], references: [id], onDelete: SetNull)
  subDealers            Customer[]                @relation("ParentDealer")
  responsibleEmployee   Employee?                 @relation("EmployeeResponsible", fields: [responsibleEmployeeId], references: [id], onDelete: SetNull)
  sales                 Sale[]                    @relation("SaleCustomer")
  salesTargets          SalesTargetStore[]
  shippingCompanies     CustomerShippingCompany[]
  addresses             CustomerAddress[]
  contacts              CustomerContact[]
  promotionalBudgets    PromotionalBudget[]
}

model CustomerAddress {
  id          String   @id @default(cuid())
  customerId  String
  addressLine String?
  province    String?
  district    String?
  subdistrict String?
  postalCode  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  firstName  String?
  lastName   String?
  phone      String?
  email      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CreditLimit {
  id              String            @id @default(cuid())
  customerId      String
  limitAmount     Decimal           @db.Decimal(15, 2)
  promoAmount     Decimal?          @db.Decimal(15, 2)
  usedAmount      Decimal           @default(0) @db.Decimal(15, 2)
  availableAmount Decimal           @default(0) @db.Decimal(15, 2)
  status          CreditLimitStatus @default(ACTIVE)
  effectiveDate   DateTime
  expiryDate      DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  notes           String?
  createdById     String?           @map("created_by_id")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  // Temporary credit tracking
  temporaryCreditAmount     Decimal?  @default(0) @db.Decimal(15, 2)
  temporaryCreditExpiryDate DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model TemporaryCreditLimit {
  id              String                @id @default(cuid())
  customerId      String
  requestedAmount Decimal               @db.Decimal(15, 2)
  expiryDate      DateTime
  notes           String?
  status          TemporaryCreditStatus @default(PENDING)
  rejectionReason String?
  requestedById   String?
  requestedAt     DateTime              @default(now())
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?

  // Track which credit limit this was applied to
  appliedToCreditLimitId String?
  isReverted             Boolean   @default(false)
  revertedAt             DateTime?

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  requestedBy User?    @relation("TemporaryCreditRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy  User?    @relation("TemporaryCreditApprover", fields: [approvedById], references: [id], onDelete: SetNull)
}

model PromotionalBudget {
  id                  String            @id @default(cuid())
  customerId          String
  year                Int // ปีงบประมาณ
  salesPromotionLimit Decimal           @default(0) @db.Decimal(15, 2) // วงเงินส่งเสริมการขายทั้งหมด
  salesPromotionUsed  Decimal           @default(0) @db.Decimal(15, 2) // ยอดใช้ไปแล้ว (ส่งเสริมการขาย)
  marketingLimit      Decimal           @default(0) @db.Decimal(15, 2) // วงเงินส่งเสริมการตลาดทั้งหมด
  marketingUsed       Decimal           @default(0) @db.Decimal(15, 2) // ยอดใช้ไปแล้ว (ส่งเสริมการตลาด)
  status              CreditLimitStatus @default(ACTIVE)
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  customer Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  details  PromotionalBudgetDetail[]

  @@unique([customerId, year])
  @@index([customerId])
}

model PromotionalBudgetDetail {
  id              String                @id @default(cuid())
  budgetId        String
  type            PromotionalBudgetType // ประเภทงบประมาณ
  receivedAmount  Decimal?              @db.Decimal(15, 2) // ยอดเงินที่ได้รับ
  usedAmount      Decimal?              @db.Decimal(15, 2) // ยอดเงินที่ใช้
  transactionDate DateTime              @default(now())
  description     String? // รายละเอียดการใช้งาน/หมายเหตุ
  saleId          String? // อ้างอิงเอกสารการขาย (ถ้ามี)
  createdById     String? // ผู้บันทึกรายการ
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?

  budget PromotionalBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  sale   Sale?             @relation("SaleBudgetDetails", fields: [saleId], references: [id], onDelete: SetNull)
}

// ==========================================
// SHIPPING COMPANIES
// ==========================================

model ShippingCompany {
  id          String                @id @default(cuid())
  name        String // ชื่อบริษัทขนส่ง
  phone       String? // เบอร์โทร
  address     String? // ที่อยู่บริษัทขนส่ง
  addressLine String? // บ้านเลขที่, ถนน
  province    String?
  district    String?
  subdistrict String?
  postalCode  String?
  notes       String? // หมายเหตุ
  status      ShippingCompanyStatus @default(ACTIVE) // สถานะการใช้งาน
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  deletedAt   DateTime? // Soft delete

  customers CustomerShippingCompany[] // ลูกค้าที่ใช้บริการขนส่ง
  sales     Sale[]                    @relation("SaleShippingCompany") // การขายที่ใช้บริษัทขนส่งนี้
  shipments Shipment[]                @relation("ShipmentShippingCompany") // Shipments ที่ใช้บริษัทขนส่งนี้
}

// Junction table สำหรับความสัมพันธ์ Many-to-Many ระหว่าง Customer และ ShippingCompany
model CustomerShippingCompany {
  id                String   @id @default(cuid())
  customerId        String
  shippingCompanyId String
  createdAt         DateTime @default(now())

  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shippingCompany ShippingCompany @relation(fields: [shippingCompanyId], references: [id], onDelete: Cascade)

  @@unique([customerId, shippingCompanyId])
  @@index([customerId])
  @@index([shippingCompanyId])
}

// หมวดสินค้า (Product Category)
model ProductCategory {
  id          String    @id @default(cuid())
  code        String // รหัสหมวดสินค้า
  description String // คำอธิบายหมวดสินค้า
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  productGroups TradeNameGroup[]
  products      Product[] // Products in this category
}

// กลุ่มชื่อการค้า (Trade Name Group)
model TradeNameGroup {
  id          String    @id @default(cuid())
  code        String    @unique // รหัสกลุ่มชื่อการค้า
  description String // คำอธิบายกลุ่มชื่อการค้า
  categoryId  String? // FK to ProductCategory
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  products Product[]
}

// ประเภท (ABC Code) (Product ABC Types)
model ProductABCTypes {
  id          String    @id @default(cuid())
  code        String // รหัสประเภทสินค้า
  name        String // ชื่อประเภทสินค้า
  description String? // รายละเอียดประเภทสินค้า
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  products Product[]
}

// หน่วยนับ (Unit)
model Unit {
  id          String    @id @default(cuid())
  code        String    @unique // รหัสหน่วยนับ
  description String // คำอธิบายหน่วยนับ
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

// แบรนด์สินค้า (Brand)
model Brand {
  id          String    @id @default(cuid())
  code        String    @unique // รหัสแบรนด์
  description String // คำอธิบายแบรนด์
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model Plant {
  id                   String    @id @default(cuid())
  code                 String    @unique // รหัสพืช
  name                 String // ชื่อพืช
  abbreviation         String? // ตัวย่อพืช
  group                String? // กลุ่มพืช
  recommendedMedicines String? // ใช้กับตัวยาที่แนะนำ
  description          String? // คำอธิบายพืช
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  @@index([code])
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Product {
  id                     String        @id @default(cuid())
  productCode            String        @unique
  name                   String
  commonName             String?
  unit                   String?
  tradeNameGroupId       String? // FK to TradeNameGroup (กลุ่มชื่อการค้า)
  brand                  String?
  packageSize            Decimal?      @db.Decimal(15, 3)
  packageSizeUnit        String?
  packageSizePerBox      Decimal?      @db.Decimal(15, 3)
  totalPackageSizePerBox Decimal?      @db.Decimal(15, 3)
  status                 ProductStatus @default(ACTIVE)
  usedForPlants          String[]
  salesPoint             String?
  properties             String?
  price                  Decimal?      @db.Decimal(15, 2)
  cartonPrice            Decimal?      @db.Decimal(15, 2)
  promotionBudget        Decimal?      @db.Decimal(15, 2)
  pointPerUnit           Int           @default(0)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  deletedAt              DateTime?

  // Category and ABC Type relations
  categoryId       String? // FK to ProductCategory (หมวดสินค้า)
  productABCTypeId String? // FK to ProductABCTypes (ประเภท (ABC Code))
  productGroupId   String? // FK to ProductGroup (กลุ่มสินค้า)

  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  productABCType ProductABCTypes? @relation(fields: [productABCTypeId], references: [id], onDelete: SetNull)
  tradeNameGroup TradeNameGroup?  @relation(fields: [tradeNameGroupId], references: [id], onDelete: SetNull)
  productGroup   ProductGroup?    @relation(fields: [productGroupId], references: [id], onDelete: SetNull)

  images               ProductImage[]
  promotionItems       ProductPromotionItem[]
  freeItems            ProductFreeItem[]
  stockLots            ProductStockLot[]
  saleItems            SaleItem[]             @relation("SaleItemProduct")
  stock                ProductStock?
  detailedSalesTargets SalesTargetItem[]
  pointHistories       EmployeePointHistory[]

  parentId String?
  parent   Product?  @relation("ProductChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children Product[] @relation("ProductChildren")
}

// กลุ่มสินค้า (Product Group)
model ProductGroup {
  id           String    @id @default(cuid())
  code         String    @unique // รหัสกลุ่มสินค้า
  name         String    @default("") // ชื่อกลุ่มสินค้า
  abbreviation String? // ตัวย่อกลุ่มสินค้า
  description  String? // คำอธิบายกลุ่มสินค้า
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  products Product[]
}

model ProductStock {
  id                String   @id @default(cuid())
  productId         String   @unique
  physicalBalance   Int      @default(0) // Total items in warehouse (Available + Reserved)
  reservedQuantity  Int      @default(0) // Allocated to active orders
  availableQuantity Int      @default(0) // Ready to sell (Physical - Reserved)
  updatedAt         DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CustomerImage {
  id         String   @id @default(cuid())
  customerId String
  url        String
  filename   String
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  filename  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ShowProductImage {
  id          String   @id @default(cuid())
  url         String
  filename    String
  title       String?  // e.g. "สินค้าแนะนำ 1"
  description String?  // e.g. "คุณภาพระดับพรีเมียม"
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductFreeItem {
  id          String   @id @default(cuid())
  productId   String
  purchaseQty Int
  freeQty     Int
  netPrice    Decimal? @db.Decimal(15, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductPromotionItem {
  id        String   @id @default(cuid())
  productId String
  name      String
  quantity  Int
  price     Decimal? @db.Decimal(15, 2)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductStockLot {
  id              String    @id @default(cuid())
  productId       String
  lotNumber       String
  quantity        Int
  initialQuantity Int       @default(0)
  importDate      DateTime
  expiryDate      DateTime?
  storageLocation String?
  notes           String?
  isUsed          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItemLots SaleItemLot[] // การใช้งาน LOT นี้ในการขาย
}

enum SaleStatus {
  PENDING_APPROVAL // รออนุมัติ
  APPROVED // อนุมัติแล้ว
  REJECTED // ไม่อนุมัติ
  PAID // ชำระเงินแล้ว
  AWAITING_DELIVERY // รอดำเนินการจัดส่งสินค้า
  DELIVERY_COMPLETED // ส่งเสร็จแล้ว
  PARTIALLY_DELIVERED // ส่งบางส่วนแล้ว (มี Split Shipment)
  OVERDUE // เลยกำหนดครบชำระ
  WAITING_FOR_CORRECTION // รอแก้ไข
  CANCELLED // ยกเลิก
  COMPLETED // เสร็จสิ้น
}

enum PaymentTerm {
  CREDIT_90 // ส่งสินค้าก่อน (เครดิต 90 วัน)
  CASH_7 // ชำระเงินสด ไม่ลด (เครดิต 7 วัน )
  CASH_DISCOUNT_3_7 // ชำระเงินสด ลด 3% (เครดิต 7 วัน)
  PREPAID // ชำระเงินก่อนส่งสินค้า (โอนเงินก่อนส่งสินค้า)
  CREDIT_OVER_90 // ส่งสินค้าก่อน (เครดิตมากกว่า 90 วัน) - Admin only
}

model Sale {
  id          String      @id @default(cuid()) // รหัสเอกสารการขาย (Primary Key)
  saleNumber  String      @unique // เลขที่เอกสาร (เช่น SN-202310-001)
  customerId  String // รหัสลูกค้า
  region      String? // ภูมิภาคของลูกค้า/ร้านค้า
  employeeId  String // รหัสพนักงานขายที่ดูแล (เซลส์)
  status      SaleStatus  @default(PENDING_APPROVAL) // สถานะบันทึกการขาย (เช่น รออนุมัติ, อนุมัติแล้ว)
  paymentTerm PaymentTerm // เงื่อนไขการชำระเงิน (เช่น เงินสด, เครดิต)

  // Credit information (ข้อมูลเครดิต)
  creditDays            Int? // จำนวนวันเครดิต (เช่น 30, 60, 90 วัน)
  creditDueDate         DateTime? // วันครบกำหนดชำระเงิน
  usePromotionalCredit  Boolean   @default(false) // ใช้เครดิตโปรโมชั่นหรือไม่
  promotionalCreditUsed Decimal?  @db.Decimal(15, 2) // จำนวนวงเงินเครดิตโปรโมชั่นที่ถูกใช้งาน

  // Dates (ข้อมูลวันที่)
  saleDate              DateTime // วันที่ทำเอกสารการขาย
  requestedDeliveryDate DateTime? // วันที่ลูกค้าต้องการให้จัดส่งสินค้า
  deliveryDate          DateTime? // วันที่กำหนดส่งสินค้า
  actualDeliveryDate    DateTime? // วันที่จัดส่งสินค้าสำเร็จจริง
  deliveryUpdateCount   Int       @default(0) // จำนวนครั้งที่อัปเดตวันส่ง
  maxDeliveryUpdates    Int       @default(3) // จำนวนครั้งสูงสุดที่อนุญาตให้แก้ไขวันส่ง
  isDeliveryLocked      Boolean   @default(false) // ล็อคการแก้ไขวันที่จัดส่ง/ใบสั่งซื้อ
  isStockDeducted       Boolean   @default(false) // ระบุว่าเอกสารนี้มีการตัดสต็อกไปแล้วหรือไม่
  orderExpiryDate       DateTime? // วันที่ใบสั่งซื้อหมดอายุ (เช่น อนุมัติ + 3 วัน)
  firstAwaitingDeliveryAt DateTime? // วันที่เปลี่ยนสถานะเป็น รอดำเนินการจัดส่งสินค้า (AWAITING_DELIVERY) ครั้งแรก
  lastDeliveryUpdate    DateTime? // วันที่อัปเดตวันส่งล่าสุด
  deliveryMethod        String? // วิธีการจัดส่ง (เช่น SALES_DELIVERY พนักงานส่ง, CUSTOMER_PICKUP ลูกค้ารับเอง)
  pickupCompanyId       String? // รหัสสถานที่รับสินค้าเอง (FK to Company)
  shippingCompanyId     String? // รหัสบริษัทขนส่งที่เลือก (FK to ShippingCompany)

  // Addresses (ข้อมูลที่อยู่เดิม - อาจจะยกเลิกใช้ในอนาคต)
  useCustomShipping Boolean @default(false) // ระบุว่ากรอกที่อยู่จัดส่งเองหรือไม่ (ไม่ได้ดึงจากประวัติลูกค้า)
  selectedAddressId String? // รหัสที่อยู่จัดส่งที่เลือกจากประวัติที่อยู่ของลูกค้า

  // Detailed Addresses & Snapshots (ข้อมูลที่อยู่แบบละเอียดและ Snapshot)
  saleAddress   SaleAddress?
  budgetDetails PromotionalBudgetDetail[] @relation("SaleBudgetDetails")

  // Amounts (จำนวนเงินและการคำนวณ)
  subtotalAmount        Decimal @db.Decimal(15, 2) // ยอดรวมสินค้า (ก่อนหักส่วนลด หรือบวกเพิ่ม)
  shippingCost          Decimal @default(0) @db.Decimal(15, 2) // ค่าจัดส่ง
  otherCosts            Decimal @default(0) @db.Decimal(15, 2) // ค่าใช้จ่ายอื่นๆ เพิ่มเติม
  otherCostsDescription String? // คำอธิบายค่าใช้จ่ายอื่นๆ
  totalAmount           Decimal @db.Decimal(15, 2) // ยอดรวมสุทธิ (Net Total)

  // External reference (เลขอ้างอิง)
  saleOrderRef String? // เลขที่เอกสารอ้างอิง (เช่น PO จากลูกค้า, Ref จากระบบอื่น)

  // Notes (หมายเหตุ)
  notes         String? // หมายเหตุทั่วไป (คนสร้าง - เซลส์/ออฟฟิศ)
  approverNotes String? // หมายเหตุคนอนุมัติ
  managerNotes  String? // หมายเหตุคนจัดการคำสั่งขาย (Fulfillment)

  // Payment information (ข้อมูลการชำระเงิน)
  paymentDate  DateTime? // วันที่ชำระเงินจริง
  paymentNotes String? // หมายเหตุการรับชำระเงิน

  // Delivery notes (หมายเหตุจัดส่ง)
  deliveryNotes String? // หมายเหตุการจัดส่ง (ข้อความถึงคนขับรถ หรือบริษัทขนส่ง)

  // Approval information (ข้อมูลการอนุมัติ)
  approvedById    String? // รหัสผู้ทำการอนุมัติเอกสาร
  approvedAt      DateTime? // วันและเวลาที่เอกสารได้รับการอนุมัติ
  rejectionReason String? // เหตุผลที่ไม่อนุมัติ (ปัดตก)
  rejectedAt      DateTime? // วันและเวลาที่ถูกไม่อนุมัติ

  // Signature (ข้อมูลการเซ็นชื่อ)
  preparedBySignatureDate  DateTime? // วันที่เซ็นชื่อ (ผู้จัดทำ)
  preparedBySignatureImage String? // รูปภาพลายเซ็น (ผู้จัดทำ)

  checkedBySignatureDate  DateTime? // วันที่เซ็นชื่อ (ผู้ตรวจสอบ)
  checkedBySignatureImage String? // รูปภาพลายเซ็น (ผู้ตรวจสอบ)

  approvedBySignatureDate  DateTime? // วันที่เซ็นชื่อ (ผู้อนุมัติ)
  approvedBySignatureImage String? // รูปภาพลายเซ็น (ผู้อนุมัติ)

  // Audit fields (ข้อมูลบันทึกระบบ)
  createdById String // รหัสผู้สร้างบันทึกการขาย
  createdAt   DateTime  @default(now()) // วันและเวลาที่สร้างเอกสาร
  updatedAt   DateTime  @updatedAt // วันและเวลาที่แก้ไขบันทึกล่าสุด
  deletedAt   DateTime? // วันเวลาที่ลบเอกสาร (Soft Delete)

  // Relations
  customer        Customer         @relation("SaleCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  employee        Employee         @relation("SaleEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy       User             @relation("SaleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy      User?            @relation("SaleApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  pickupCompany   Company?         @relation("SalePickupCompany", fields: [pickupCompanyId], references: [id], onDelete: SetNull)
  shippingCompany ShippingCompany? @relation("SaleShippingCompany", fields: [shippingCompanyId], references: [id], onDelete: SetNull)

  items          SaleItem[]
  statusHistory  SaleStatusHistory[]
  pointHistories EmployeePointHistory[]
  shipments      Shipment[] // การจัดส่งทั้งหมด (Split Shipment)

  // Partial Delivery
  hasPartialDelivery Boolean @default(false) // true = มีการจัดส่งแบบแบ่งครั้ง

  @@index([customerId, saleDate])
  @@index([employeeId, saleDate])
}

model SaleItem {
  id        String @id @default(cuid())
  saleId    String
  productId String

  // Product Snapshot (ข้อมูลสินค้าย้อนหลัง)
  productCode            String?
  name                   String?
  commonName             String?
  unit                   String?
  productGroupId         String? // Snapshot of productGroupId
  productGroupName       String? // Snapshot of productGroup name
  productABCTypeId       String? // Snapshot of productABCTypeId
  tradeNameGroupId       String? // Snapshot of tradeNameGroupId
  tradeNameGroupName     String? // Snapshot of tradeNameGroup name
  categoryId             String? // Snapshot of categoryId
  categoryName           String? // Snapshot of category name
  brand                  String?
  packageSize            Decimal? @db.Decimal(15, 3)
  packageSizeUnit        String?
  packageSizePerBox      Decimal? @db.Decimal(15, 3)
  totalPackageSizePerBox Decimal? @db.Decimal(15, 3)
  status                 ProductStatus?
  usedForPlants          String[]
  salesPoint             String?
  properties             String?
  price                  Decimal? @db.Decimal(15, 2)
  cartonPrice            Decimal? @db.Decimal(15, 2)
  promotionBudget        Decimal? @db.Decimal(15, 2)
  pointPerUnit           Int?
  productABCTypeName     String? // Snapshot of ProductABCType name
  parentId               String? // Snapshot of parentId

  quantity      Int
  unitPrice     Decimal  @db.Decimal(15, 2)
  originalPrice Decimal  @db.Decimal(15, 2)
  priceModified Boolean  @default(false)
  totalPrice    Decimal  @db.Decimal(15, 2)
  stockAtSale   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sale           Sale                  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product               @relation("SaleItemProduct", fields: [productId], references: [id], onDelete: Restrict)
  lotAllocations SaleItemLot[] // LOT ที่ใช้สำหรับสินค้านี้
  pointHistory   EmployeePointHistory?
  shipmentItems  ShipmentItem[]        @relation("ShipmentItemSaleItem") // รายการใน Split Shipment
}

model EmployeePointHistory {
  id           String   @id @default(cuid())
  employeeId   String
  saleId       String
  saleItemId   String
  productId    String
  quantity     Int
  pointPerUnit Int
  totalPoints  Int
  createdAt    DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleItem SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([saleItemId])
  @@index([employeeId, createdAt])
  @@index([saleId])
}

model EmployeePointSummary {
  employeeId  String   @id
  totalPoints Int      @default(0)
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// เก็บข้อมูลว่า SaleItem แต่ละรายการใช้ LOT ไหนบ้าง
model SaleItemLot {
  id         String   @id @default(cuid())
  saleItemId String
  lotId      String
  quantity   Int // จำนวนที่ใช้จาก LOT นี้
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  saleItem SaleItem        @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  lot      ProductStockLot @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@unique([saleItemId, lotId])
  @@index([saleItemId])
  @@index([lotId])
}

// ==========================================
// SALE ADDRESS
// ==========================================
model SaleAddress {
  id     String @id @default(cuid())
  saleId String @unique

  // Reference IDs (อ้างอิง Master Data)
  companyAddressId          String? // ที่อยู่บริษัทเรา (ออกเอกสาร)
  billingCustomerAddressId  String? // ที่อยู่วางบิล (ของลูกค้า)
  shippingCustomerAddressId String? // ที่อยู่จัดส่ง (ของลูกค้า)
  pickupCompanyAddressId    String? // ที่อยู่รับสินค้า (สาขา/โกดังเรา)
  shippingCompanyAddressId  String? // ที่อยู่บริษัทขนส่ง (สำนักงาน/จุดรับ)

  // ที่อยู่ลูกค้า
  company_name        String?
  company_phone       String?
  address_line        String?
  address_province    String?
  address_district    String?
  address_subdistrict String?
  address_code        String?
  company_note        String?

  // ที่อยู่วางบิล
  billing_address_line String?
  billing_province     String?
  billing_district     String?
  billing_subdistrict  String?
  billing_postal_code  String?
  billing_note         String?

  // ที่อยู่จัดส่งสินค้า
  shipping_address_line String?
  shipping_province     String?
  shipping_district     String?
  shipping_subdistrict  String?
  shipping_postal_code  String?
  shipping_note         String?

  // ที่อยู่รับสินค้า
  receiving_name         String?
  receiving_phone        String?
  receiving_address_line String?
  receiving_province     String?
  receiving_district     String?
  receiving_subdistrict  String?
  receiving_postal_code  String?
  receiving_note         String?

  // ที่อยู่ขนส่ง
  sender_name        String?
  sender_phone       String?
  sender_line        String?
  sender_province    String?
  sender_district    String?
  sender_subdistrict String?
  sender_postal_code String?
  sender_note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model SaleStatusHistory {
  id          String     @id @default(cuid())
  saleId      String
  status      SaleStatus
  notes       String?
  changedById String
  changedAt   DateTime   @default(now())

  sale      Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  changedBy User @relation("StatusHistoryUser", fields: [changedById], references: [id], onDelete: Restrict)
}

// ==========================================
// PARTIAL DELIVERY / SPLIT SHIPMENT
// ==========================================

enum ShipmentStatus {
  PENDING    // สร้างแล้ว รอดำเนินการ
  IN_TRANSIT // ระหว่างขนส่ง
  DELIVERED  // ส่งเสร็จแล้ว
  COMPLETED  // เสร็จสิ้น
  CANCELLED  // ยกเลิก
}

model Shipment {
  id                String         @id @default(cuid())
  saleId            String
  shipmentNumber    Int // ลำดับที่ต่อ Sale (1, 2, 3...)
  status            ShipmentStatus @default(PENDING)
  scheduledDate     DateTime? // วันกำหนดส่ง
  actualDate        DateTime? // วันส่งจริง
  paymentDate       DateTime? // วันที่ชำระเงิน
  dueDate           DateTime? // วันครบกำหนดชำระ
  salesOrderNumber  String? // เลขที่คำสั่งขาย
  shippingCompanyId   String? // FK to ShippingCompany
  shippingCompanyName String? // ชื่อบริษัทขนส่ง (Snapshotted)
  deliveryMethod      String? // วิธีการจัดส่ง (เช่น SALES_DELIVERY พนักงานส่ง, CUSTOMER_PICKUP ลูกค้ารับเอง)
  pickupCompanyId     String? // รหัสสถานที่รับสินค้าเอง
  pickupCompanyName   String? // ชื่อสถานที่รับสินค้า (Snapshotted)
  shippingAddress     String? // ที่อยู่สำหรับจัดส่ง
  customerShippingAddress String? // ที่อยู่จัดส่งลูกค้าปลายทาง (กรณีเลือกที่อยู่อื่น)
  notes             String? // หมายเหตุ
  totalAmount       Decimal        @default(0) @db.Decimal(15, 2) // มูลค่าสินค้าในรอบนี้
  shippingDiscount  Decimal        @default(0) @db.Decimal(15, 2) // ส่วนลดค่าขนส่ง
  billDiscount      Decimal        @default(0) @db.Decimal(15, 2) // ส่วนลดหน้าบิล
  createdById       String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  sale            Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  shippingCompany ShippingCompany? @relation("ShipmentShippingCompany", fields: [shippingCompanyId], references: [id], onDelete: SetNull)
  items           ShipmentItem[]
  createdBy       User             @relation("ShipmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([saleId, shipmentNumber])
  @@index([saleId])
  @@index([shippingCompanyId])
}

model ShipmentItem {
  id         String  @id @default(cuid())
  shipmentId String
  saleItemId String
  quantity   Int // จำนวนสินค้าที่ส่งในรอบนี้
  unitPrice  Decimal @default(0) @db.Decimal(15, 2) // ราคาต่อหน่วย ณ เวลาส่ง
  totalPrice Decimal @default(0) @db.Decimal(15, 2) // quantity × unitPrice

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  saleItem SaleItem @relation("ShipmentItemSaleItem", fields: [saleItemId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, saleItemId])
  @@index([shipmentId])
  @@index([saleItemId])
}

// ==========================================
// SALES TARGETS
// ==========================================

// เป้ายอดขายรวมรายเดือน/รายปี
model MonthlySalesTarget {
  id           String  @id @default(cuid())
  year         Int // ปี พ.ศ. หรือ ค.ศ.
  month        Int? // เดือน (1-12), null = เป้าหมายรายปี
  targetAmount Decimal @db.Decimal(15, 2) // เป้ายอดขาย (บาท)
  notes        String? // หมายเหตุเพิ่มเติม

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([year, month]) // ป้องกันข้อมูลซ้ำซ้อน
  @@index([year])
}

// ==========================================
// LOGGING SYSTEM
// ==========================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  APPROVE
  REJECT
  EXPORT
  IMPORT
  LOGIN
  LOGOUT
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGE
  PASSWORD_RESET
  PERMISSION_CHANGE
  ROLE_CHANGE
  ADMIN_ACTION
  DATA_EXPORT
  SUSPICIOUS_ACTIVITY
  SESSION_EXPIRED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
}

enum LogSeverity {
  DEBUG
  INFO
  WARN
  ERROR
  CRITICAL
}

model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())

  // Who performed the action
  userId    String?
  userEmail String?
  userName  String?
  ipAddress String?
  userAgent String?

  // What action was performed
  action     AuditAction
  entityType String // Sale, Customer, CreditLimit, User, Product, etc.
  entityId   String?
  entityName String? // Human-readable name (e.g., customer name, sale number)

  // Data Changes
  oldValue      Json? // State before change
  newValue      Json? // State after change
  changedFields String[] // List of changed field names

  // Context
  module    String? // sales, customers, products, users, etc.
  requestId String? // Correlation ID for tracing
  sessionId String?
  endpoint  String? // API endpoint that was called
  method    String? // HTTP method (GET, POST, PUT, DELETE)

  // Result
  success      Boolean @default(true)
  errorMessage String?
  duration     Int? // Request duration in milliseconds

  // Optional relation to User
  user User? @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, timestamp])
  @@index([entityType, entityId])
  @@index([entityType, timestamp])
  @@index([action, timestamp])
  @@index([timestamp])
  @@index([module, timestamp])
}

model SecurityLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())

  // Event Information
  eventType SecurityEventType
  severity  LogSeverity       @default(INFO)
  message   String?

  // Who triggered the event
  userId    String?
  userEmail String?
  userName  String?

  // Request Information
  ipAddress   String
  userAgent   String?
  geoLocation String? // Country/City if available

  // Session Information
  sessionId String?
  requestId String?

  // Event Details
  details         Json? // Additional context
  targetUserId    String? // For admin actions affecting other users
  targetUserEmail String?

  // Result
  success       Boolean @default(true)
  failureReason String?

  // Risk Assessment
  riskScore Int? // 0-100, higher = more risky
  isBlocked Boolean @default(false)

  // Rate Limiting
  attemptCount Int @default(1) // For tracking repeated failures

  // Optional relation to User
  user       User? @relation("SecurityLogUser", fields: [userId], references: [id], onDelete: SetNull)
  targetUser User? @relation("SecurityLogTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([userId, timestamp])
  @@index([eventType, timestamp])
  @@index([ipAddress, timestamp])
  @@index([severity, timestamp])
  @@index([timestamp])
  @@index([riskScore])
}

model ApplicationLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())

  // Log Information
  level   LogSeverity
  message String

  // Context
  module       String? // Component/module name
  functionName String?

  // Request Context
  requestId String?
  userId    String?
  sessionId String?

  // Error Details
  errorName    String?
  errorMessage String?
  stackTrace   String? @db.Text

  // Additional Data
  metadata Json?

  // Performance
  duration Int? // milliseconds

  @@index([level, timestamp])
  @@index([module, timestamp])
  @@index([requestId])
  @@index([timestamp])
}

// ==========================================
// NOTIFICATIONS
// ==========================================

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  APPROVED
  REJECTED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

// ==========================================
// NEW SALES TARGETS (DETAILED)
// ==========================================

// เป้าหมายการขาย: 1 record ต่อ 1 เดือน ต่อ 1 พนักงาน
model SalesTarget {
  id         String  @id @default(cuid())
  year       Int
  month      Int
  employeeId String  // พนักงาน
  region     String? // ภูมิภาค โดยอ้างอิงจากร้านค้า

  employee Employee             @relation(fields: [employeeId], references: [id])
  stores   SalesTargetStore[]
  history  SalesTargetHistory[] // ประวัติการเปลี่ยนแปลง

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([year, month, employeeId]) // 1 เป้าต่อ 1 พนักงาน ต่อ 1 เดือน
  @@index([year, month])
  @@index([employeeId])
}

// ร้านค้าในเป้าหมาย: 1 ร้าน ต่อ 1 เป้าหมาย
model SalesTargetStore {
  id            String @id @default(cuid())
  salesTargetId String
  customerId    String // ร้านค้า

  salesTarget SalesTarget       @relation(fields: [salesTargetId], references: [id], onDelete: Cascade)
  customer    Customer          @relation(fields: [customerId], references: [id])
  items       SalesTargetItem[]

  @@unique([salesTargetId, customerId]) // ไม่ซ้ำร้านค้าในเป้าหมายเดียวกัน
  @@index([salesTargetId])
  @@index([customerId])
}

// สินค้าในร้านค้า: หลายสินค้าต่อ 1 ร้าน
model SalesTargetItem {
  id                 String  @id @default(cuid())
  salesTargetStoreId String
  productId          String
  pricePerBox        Decimal @default(0) @db.Decimal(15, 2)
  qtyPerBox          Int     @default(0)
  targetAmount       Decimal @default(0) @db.Decimal(15, 2)

  salesTargetStore SalesTargetStore @relation(fields: [salesTargetStoreId], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [productId], references: [id])

  @@index([salesTargetStoreId])
  @@index([productId])
}

// ==========================================
// SALES TARGET HISTORY (Audit Trail)
// ==========================================

enum SalesTargetChangeType {
  CREATED // สร้างใหม่
  UPDATED // แก้ไข
  DELETED // ลบ
}

// ประวัติการเปลี่ยนแปลงเป้าหมายการขาย
// เก็บ snapshot แบบ JSON ก่อน/หลังการเปลี่ยนแปลง
model SalesTargetHistory {
  id            String                @id @default(cuid())
  salesTargetId String // FK ไปยัง SalesTarget ที่ถูกแก้ไข
  changeType    SalesTargetChangeType // CREATE / UPDATE / DELETE
  changedById   String // ใครแก้ไข (FK to User)
  changedAt     DateTime              @default(now())

  // Snapshot ข้อมูลเต็ม (JSON) เพื่อให้ดูย้อนหลังได้โดยไม่ต้อง JOIN
  snapshotBefore Json? // ข้อมูลก่อนแก้ไข (null เมื่อ CREATE)
  snapshotAfter  Json? // ข้อมูลหลังแก้ไข (null เมื่อ DELETE)

  // สรุปการเปลี่ยนแปลงเพื่อแสดงใน UI ได้รวดเร็ว
  changeSummary String? // เช่น "แก้ไขสินค้า 3 รายการ, เพิ่มร้านค้า 1 แห่ง"

  // Relations
  salesTarget SalesTarget @relation(fields: [salesTargetId], references: [id], onDelete: Cascade)
  changedBy   User        @relation("SalesTargetHistoryUser", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([salesTargetId, changedAt])
  @@index([changedById, changedAt])
  @@index([changedAt])
}

model FailedLoginAttempt {
  id              String   @id @default(cuid())
  email           String   // อีเมลที่พยายามใช้ล็อกอิน
  passwordAttempt String?  // รหัสผ่าน (masked เพื่อความปลอดภัย)
  ipAddress       String?  // ไอพีแอดเดรส
  userAgent       String?  // ข้อมูลเบราว์เซอร์
  createdAt       DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// ==========================================
// LOGIN ANNOUNCEMENT (Post-Login Popup)
// ==========================================

model LoginAnnouncement {
  id        String    @id @default(cuid())
  imageUrl  String
  title     String?
  roles     String[]
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// ==========================================
// ==========================================
// ACTIVITY FEATURE ENUMS
// ==========================================

enum ActivityStatus {
  DRAFT                       // แผนร่าง
  PENDING_LINE_APPROVAL       // รออนุมัติตามสายงาน (Step 2: Line Approval)
  PENDING_BUDGET_APPROVAL     // รออนุมัติงบประมาณ (Step 3: Budget Approval)
  PENDING_HELPER_APPROVAL     // รออนุมัติผู้ช่วยงาน (Step 4: Helper Approval)
  APPROVED                    // อนุมัติสมบูรณ์และบันทึกปฏิทินสำเร็จ (Step 5)
  REJECTED                    // ถูกปฏิเสธ (ปัดตกแผนงาน)
  WAITING_FOR_CORRECTION      // ถูกส่งกลับแก้ไข/ขอข้อมูลเพิ่มเติม (ตีกลับ)
  CANCELLED                   // ยกเลิกแผนงานโดยผู้สร้าง
}

enum ActivityHelperStatus {
  PENDING                     // รออนุมัติจาก ผจก. แผนกของคนช่วย
  APPROVED                    // อนุมัติให้ไปช่วยงานได้
  REJECTED                    // ไม่อนุมัติให้ไปช่วยงาน (ต้องเปลี่ยนคนช่วยใหม่)
}

enum ActivityApprovalAction {
  SUBMIT                      // ส่งขออนุมัติ
  APPROVE                     // อนุมัติผ่าน
  REJECT                      // ปฏิเสธ (ปัดตก)
  REQUEST_CORRECTION          // ตีกลับแก้ไข
  CANCEL                      // ยกเลิก
}

enum ActivityApprovalStep {
  LINE_APPROVAL               // ตรวจสอบเบื้องต้นตามสายงาน (Step 2)
  BUDGET_APPROVAL             // ตรวจสอบเงื่อนไขงบประมาณ (Step 3)
  HELPER_APPROVAL             // ตรวจสอบการช่วยงาน (Step 4)
}

enum ActivityResultStatus {
  COMPLETED                   // ทำสำเร็จตามแผน
  PARTIAL                     // ทำได้บางส่วน
  FAILED                      // ไม่สำเร็จ / ต้องยกเลิก ณ วันงาน
}

// ==========================================
// ACTIVITY FEATURE MODELS
// ==========================================

// ─── GROUP 1: Master / Lookup ─────────────────────────────────────────────────

model ActivityType {
  id          String  @id @default(cuid())
  code        String  @unique // "TYPE_1" ... "TYPE_11"
  name        String          // "เข้าพบร้านค้า / Key Farmer"
  shortName   String?         @map("short_name") // "Visit", "Sales", ...
  description String?
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  activityPlans ActivityPlan[]

  @@map("activity_types")
}

// ─── GROUP 2: Core Transaction ────────────────────────────────────────────────

model ActivityPlan {
  id             String         @id @default(cuid())
  code           String?        @unique @map("code") // เลขที่แผน (TPYYMMXXXX)

  // ──── WHO ──────────────────────────────────────────────
  employeeId     String         @map("employee_id")            // พนักงานผู้สร้างแผน
  createdById    String         @map("created_by_id")          // บัญชีผู้ใช้งานที่สร้างแผน

  // ──── WHAT ─────────────────────────────────────────────
  activityTypeId String         @map("activity_type_id")       // FK → ActivityType
  title          String
  objective      String
  description    String?
  notes          String?

  // ──── WHEN (+ Fiscal Dimensions for Analytics) ─────────
  startDate      DateTime       @map("start_date")
  endDate        DateTime       @map("end_date")
  durationDays   Int            @default(1) @map("duration_days")   // auto-computed
  fiscalYear     Int            @map("fiscal_year")                  // auto-computed (e.g. 2026)
  fiscalMonth    Int            @map("fiscal_month")                 // auto-computed (1–12)
  fiscalQuarter  Int            @map("fiscal_quarter")               // auto-computed (1–4)

  // ──── WHERE ────────────────────────────────────────────
  province       String?        // จังหวัด (จาก dropdown)
  district       String?        // อำเภอ (จาก dropdown)
  location       String         // รายละเอียดสถานที่เต็ม

  // ──── BUDGET REQUESTED (ณ วันสร้างแผน) ────────────────
  salesPromotionBudgetRequested  Decimal? @db.Decimal(15, 2) @map("sales_promotion_budget_requested")
  marketingBudgetRequested       Decimal? @db.Decimal(15, 2) @map("marketing_budget_requested")
  totalBudgetRequested           Decimal  @default(0) @db.Decimal(15, 2) @map("total_budget_requested") // sum อัตโนมัติ

  // ──── BUDGET APPROVED (อัปเดตเมื่อผ่าน Step 3) ────────
  salesPromotionBudgetApproved   Decimal? @db.Decimal(15, 2) @map("sales_promotion_budget_approved")
  marketingBudgetApproved        Decimal? @db.Decimal(15, 2) @map("marketing_budget_approved")
  totalBudgetApproved            Decimal? @db.Decimal(15, 2) @map("total_budget_approved")

  // ──── WORKFLOW STATUS ──────────────────────────────────
  status                         ActivityStatus @default(DRAFT)
  currentApproverEmployeeId      String?        @map("current_approver_employee_id")

  // ──── APPROVAL FLAGS (Step 3 parallel tracking) ────────
  salesPromotionApproved  Boolean? @map("sales_promotion_approved")
  marketingApproved       Boolean? @map("marketing_approved")
  salesManagerApproved    Boolean? @map("sales_manager_approved")

  // ──── TAT TIMESTAMPS (สำหรับ SLA / TAT Analytics) ─────
  submittedAt  DateTime? @map("submitted_at")   // เวลาที่ส่งขออนุมัติ
  approvedAt   DateTime? @map("approved_at")    // เวลาที่ผ่านครบทุก Step
  rejectedAt   DateTime? @map("rejected_at")    // เวลาที่ถูกปฏิเสธ
  cancelledAt  DateTime? @map("cancelled_at")   // เวลาที่ยกเลิก

  // ──── METADATA & SOFT DELETE ───────────────────────────
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  employee         Employee      @relation("EmployeeActivityPlans", fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy        User          @relation("UserActivityPlans", fields: [createdById], references: [id], onDelete: Restrict)
  currentApprover  Employee?     @relation("EmployeeActivityApprovals", fields: [currentApproverEmployeeId], references: [id], onDelete: SetNull)
  activityType     ActivityType  @relation(fields: [activityTypeId], references: [id])

  items        ActivityPlanItem[]
  helpers      ActivityHelper[]
  approvalLogs ActivityApprovalLog[]
  result       ActivityResult?         // 1:1 บันทึกผลหลังกิจกรรม

  @@index([employeeId])
  @@index([activityTypeId])
  @@index([status])
  @@index([fiscalYear, fiscalMonth])
  @@index([fiscalYear, fiscalQuarter])
  @@index([province])
  @@index([submittedAt])
  @@index([approvedAt])
  @@map("activity_plans")
}

model ActivityPlanItem {
  id             String  @id @default(cuid())
  activityPlanId String  @map("activity_plan_id")
  itemOrder      Int     @default(0) @map("item_order")   // ลำดับรายการ

  // ──── SHARED (ใช้กับหลาย Type) ────────────────────────
  customerName   String? @map("customer_name")             // ร้านค้า/เกษตรกร (Type 1,2,3,4,6,9,11)
  detail         String?                                   // รายละเอียดทั่วไป

  // ──── TYPE 1: เข้าพบร้านค้า / Key Farmer ─────────────
  visitTopic     String? @map("visit_topic")               // หัวข้อเข้าพบ

  // ──── TYPE 2: ติดตามผลการใช้สินค้า ───────────────────
  followupProductName String? @map("followup_product_name")

  // ──── TYPE 3: เสนอขายสินค้า ───────────────────────────
  saleProductName String?  @map("sale_product_name")
  saleQuantity    Int?     @map("sale_quantity")
  saleUnitPrice   Decimal? @db.Decimal(15, 2) @map("sale_unit_price")
  saleTotalPrice  Decimal? @db.Decimal(15, 2) @map("sale_total_price")

  // ──── TYPE 4: วางบิล / เก็บเงิน ──────────────────────
  collectAmount   Decimal? @db.Decimal(15, 2) @map("collect_amount")

  // ──── TYPE 5: สำรวจตลาดคู่แข่ง ───────────────────────
  surveyCompetitorProduct String? @map("survey_competitor_product")
  surveyStoreName         String? @map("survey_store_name")

  // ──── TYPE 6: แก้ปัญหา / รับเรื่องร้องเรียน ──────────
  issueType      String? @map("issue_type")

  // ──── TYPE 7: ทำ/ติดตามแปลงสาธิต ─────────────────────
  plotActivityType  String?  @map("plot_activity_type")    // "CREATE" | "FOLLOW_UP"
  plotOwnerName     String?  @map("plot_owner_name")
  plotProductName   String?  @map("plot_product_name")
  plotCropCategory  String?  @map("plot_crop_category")    // หมวดพืช เช่น "ไม้ผล","พืชไร่"
  plotCropName      String?  @map("plot_crop_name")
  plotAreaRai       Decimal? @db.Decimal(10, 2) @map("plot_area_rai")
  plotTreeCount     Int?     @map("plot_tree_count")
  plotCount         Int?     @map("plot_count")            // จำนวนแปลง
  existingPlotId    String?  @map("existing_plot_id")      // FK → DemoPlot ถ้าเป็น FOLLOW_UP
  plotGrowthStage   String?  @map("plot_growth_stage")
  plotStatus        String?  @map("plot_status")

  // ──── TYPE 8: จัดประชุม ───────────────────────────────
  meetingTopic          String? @map("meeting_topic")
  meetingAttendeesCount Int?    @map("meeting_attendees_count")
  meetingTargetProducts String? @map("meeting_target_products") // CSV ชื่อสินค้าเป้าหมาย

  // ──── TYPE 9: กิจกรรมส่งเสริมการขายหน้าร้าน ──────────
  storeProductName   String?  @map("store_product_name")
  storeQuantityCases Int?     @map("store_quantity_cases")
  storePricePerCase  Decimal? @db.Decimal(15, 2) @map("store_price_per_case")
  storeTotalAmount   Decimal? @db.Decimal(15, 2) @map("store_total_amount")

  // TYPE 10 (Field Day): ใช้ existingPlotId + customerName ร่วมกับ Type 7
  // TYPE 11 (Stock): ใช้ customerName (shared)

  // Relations
  activityPlan  ActivityPlan @relation(fields: [activityPlanId], references: [id], onDelete: Cascade)

  @@index([activityPlanId])
  @@index([customerName])
  @@index([saleProductName])
  @@index([plotCropCategory])
  @@index([plotOwnerName])
  @@map("activity_plan_items")
}

model ActivityHelper {
  id             String               @id @default(cuid())
  activityPlanId String               @map("activity_plan_id")
  employeeId     String               @map("employee_id")       // พนักงานที่ไปช่วยงาน

  // Denormalized snapshot ณ วันที่สร้าง (Analytics — ไม่กระทบเมื่อโอนย้ายแผนก)
  departmentId   String?              @map("department_id")
  departmentName String?              @map("department_name")

  status          ActivityHelperStatus @default(PENDING)
  rejectionReason String?              @map("rejection_reason")

  approvedById   String?   @map("approved_by_id")
  approvedAt     DateTime? @map("approved_at")
  respondedAt    DateTime? @map("responded_at")   // เวลาที่ผู้จัดการตอบ (approve/reject)

  // Metadata & Soft Delete
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  activityPlan ActivityPlan @relation(fields: [activityPlanId], references: [id], onDelete: Cascade)
  employee     Employee     @relation("EmployeeActivityHelpers", fields: [employeeId], references: [id], onDelete: Restrict)
  approvedBy   Employee?    @relation("EmployeeApprovedHelpers", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([activityPlanId, employeeId])
  @@index([employeeId])
  @@index([status])
  @@index([departmentName])
  @@map("activity_helpers")
}

// ─── GROUP 3: Workflow ────────────────────────────────────────────────────────

model ActivityApprovalLog {
  id             String                 @id @default(cuid())
  activityPlanId String                 @map("activity_plan_id")
  userId         String                 @map("user_id")          // บัญชีผู้ใช้งานที่ทำรายการ

  action         ActivityApprovalAction
  step           ActivityApprovalStep
  fromStatus     ActivityStatus?        @map("from_status")      // สถานะก่อนเปลี่ยน
  toStatus       ActivityStatus?        @map("to_status")        // สถานะหลังเปลี่ยน
  comment        String?                                         // เหตุผล / หมายเหตุ

  // TAT tracking: เวลาที่ใช้ในแต่ละ step (วินาที) — คำนวณ ณ เวลาที่บันทึก Log
  stepDurationSeconds Int? @map("step_duration_seconds")

  createdAt  DateTime @default(now()) @map("created_at")

  activityPlan ActivityPlan @relation(fields: [activityPlanId], references: [id], onDelete: Cascade)
  user         User         @relation("UserActivityApprovalLogs", fields: [userId], references: [id], onDelete: Restrict)

  @@index([activityPlanId])
  @@index([action])
  @@index([step])
  @@index([createdAt])
  @@map("activity_approval_logs")
}

// ─── GROUP 4: Post-Activity Result ───────────────────────────────────────────

model ActivityResult {
  id             String  @id @default(cuid())
  activityPlanId String  @unique @map("activity_plan_id") // 1:1 กับ ActivityPlan

  // ──── ผลการดำเนินงาน (General) ────────────────────────
  actualStartDate      DateTime             @map("actual_start_date")      // วันที่ทำจริง
  actualEndDate        DateTime             @map("actual_end_date")
  actualAttendeesCount Int?                 @map("actual_attendees_count") // จำนวนผู้เข้าร่วมจริง

  resultStatus  ActivityResultStatus @default(COMPLETED) @map("result_status")
  resultSummary String?              @map("result_summary")  // สรุปผลกิจกรรมโดยรวม
  problemFound  String?              @map("problem_found")    // ปัญหาที่พบระหว่างทำ
  nextAction    String?              @map("next_action")       // แผนการต่อยอด / ติดตาม

  // ──── งบประมาณที่ใช้จริง ───────────────────────────────
  actualSalesPromotionSpent Decimal? @db.Decimal(15, 2) @map("actual_sales_promotion_spent")
  actualMarketingSpent      Decimal? @db.Decimal(15, 2) @map("actual_marketing_spent")
  actualTotalSpent          Decimal? @db.Decimal(15, 2) @map("actual_total_spent")

  // ──── ผลลัพธ์เชิงตัวเลขตามประเภทงาน ──────────────────
  // TYPE 3: ยอดขาย
  salesResultAmount  Decimal? @db.Decimal(15, 2) @map("sales_result_amount")  // ยอดสั่งซื้อที่ได้จริง
  salesOrdersCount   Int?     @map("sales_orders_count")                       // จำนวนใบสั่งซื้อ

  // TYPE 4: ยอดเก็บเงิน
  collectResultAmount Decimal? @db.Decimal(15, 2) @map("collect_result_amount") // เก็บได้จริง

  // TYPE 7/10: ผลแปลงสาธิต
  demoPlotsCreated    Int? @map("demo_plots_created")     // จำนวนแปลงที่สร้างจริง
  demoPlotsFollowedUp Int? @map("demo_plots_followed_up")

  // TYPE 8/9/10: ผู้เข้าร่วม
  distributorsCount Int? @map("distributors_count") // จำนวนดีลเลอร์
  farmersCount      Int? @map("farmers_count")       // จำนวนเกษตรกร

  // ──── METADATA ─────────────────────────────────────────
  recordedById String   @map("recorded_by_id")  // พนักงานที่บันทึกผล
  recordedAt   DateTime @default(now()) @map("recorded_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  activityPlan ActivityPlan @relation(fields: [activityPlanId], references: [id], onDelete: Cascade)
  recordedBy   User         @relation("UserActivityResults", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([activityPlanId])
  @@index([resultStatus])
  @@index([actualStartDate])
  @@map("activity_results")
}

// ==========================================
// PROMOTIONAL MATERIALS (สื่อส่งเสริมการขาย)
// ==========================================

enum PromotionalMaterialStatus {
  ACTIVE
  INACTIVE
}

model PromotionalMaterial {
  id          String                    @id @default(cuid())
  sku         String                    @unique // SKU หรือรหัสสินค้า
  name        String                    // ชื่อสินค้า
  shortName   String?                   @map("short_name") // ชื่อย่อ
  description String?                   // รายละเอียดสินค้า
  category    String                    // หมวดหมู่สินค้า (Premium_item, PP_Board, Banner, Leaflet, อุปกรณ์จัดงาน)
  brand       String?                   // ยี่ห้อ
  status      PromotionalMaterialStatus @default(ACTIVE) // Active / Inactive
  unit        String?                   // หน่วย
  price       Decimal?                  @default(0) @db.Decimal(15, 2) // ราคา
  quantity    Int                       @default(0) // จำนวน
  createdById String?                   @map("created_by_id") // ผู้สร้าง
  createdAt   DateTime                  @default(now()) @map("created_at") // วันที่สร้าง
  updatedById String?                   @map("updated_by_id") // ผู้แก้ไข
  updatedAt   DateTime                  @updatedAt @map("updated_at") // วันที่แก้ไข
  deletedAt   DateTime?                 @map("deleted_at") // Soft Delete

  @@index([sku])
  @@index([category])
  @@index([status])
  @@map("promotional_materials")
}

