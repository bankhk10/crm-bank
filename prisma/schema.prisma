// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum ShippingCompanyStatus {
  ACTIVE
  INACTIVE
}

enum PermissionType {
  MENU
  ACTION
  DATA
}

enum DataAccessLevel {
  VIEW_OWN // ดูได้เฉพาะตัวเอง
  VIEW_TEAM // ดูได้เฉพาะทีมเดียวกัน
  VIEW_DEPARTMENT // ดูได้เฉพาะแผนกเดียวกัน
  VIEW_ALL // ดูได้ทั้งหมด
}

enum EditAccessLevel {
  EDIT_NONE // ไม่สามารถแก้ไขได้
  EDIT_OWN // แก้ไขได้เฉพาะของตัวเอง
  EDIT_TEAM // แก้ไขได้เฉพาะทีมเดียวกัน
  EDIT_DEPARTMENT // แก้ไขได้เฉพาะของแผนกตัวเอง
  EDIT_ALL // แก้ไขได้ทั้งหมด
}

enum DeleteAccessLevel {
  DELETE_NONE // ไม่สามารถลบได้
  DELETE_OWN // ลบได้เฉพาะของตัวเอง
  DELETE_TEAM // ลบได้เฉพาะทีมเดียวกัน
  DELETE_DEPARTMENT // ลบได้เฉพาะของแผนกตัวเอง
  DELETE_ALL // ลบได้ทั้งหมด
}

enum CustomerType {
  DEALER
  SUBDEALER
  FARMER
  BROKER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CreditLimitStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum TemporaryCreditStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  password     String
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  departmentId String?
  positionId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department                     Department?              @relation("DepartmentUsers", fields: [departmentId], references: [id], onDelete: SetNull)
  position                       Position?                @relation("UserPosition", fields: [positionId], references: [id], onDelete: SetNull)
  employeeProfile                Employee?                @relation("UserEmployeeProfile")
  userRoles                      UserRole[]
  permissionOverrides            UserPermissionOverride[]
  requestedTemporaryCreditLimits TemporaryCreditLimit[]   @relation("TemporaryCreditRequester")
  approvedTemporaryCreditLimits  TemporaryCreditLimit[]   @relation("TemporaryCreditApprover")
  createdSales                   Sale[]                   @relation("SaleCreator")
  approvedSales                  Sale[]                   @relation("SaleApprover")
  saleStatusChanges              SaleStatusHistory[]      @relation("StatusHistoryUser")

  // Logging relations
  auditLogs              AuditLog[]            @relation("AuditLogUser")
  securityLogs           SecurityLog[]         @relation("SecurityLogUser")
  targetedSecurityLogs   SecurityLog[]         @relation("SecurityLogTargetUser") // Existing
  notifications          Notification[]        @relation("UserNotifications")
  salesTargetHistories   SalesTargetHistory[]  @relation("SalesTargetHistoryUser")
}

model Company {
  id          String        @id @default(cuid())
  name        String
  companyCode String?       @unique @map("company_code")
  shortName   String?       @map("short_name")
  email       String?       @unique
  phone       String?
  taxId       String?       @map("tax_id")
  addressLine String?       @map("address_line")
  province    String?
  district    String?
  subdistrict String?
  postalCode  String?
  status      CompanyStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  employees     Employee[]
  salesAsPickup Sale[]     @relation("SalePickupCompany")
}

model Employee {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  // Extended employee fields
  prefix             String?
  firstName          String?
  lastName           String?
  employeeCode       String?
  birthDate          DateTime?
  addressLine        String?   @map("address_line")
  province           String?
  district           String?
  subdistrict        String?
  postalCode         String?
  responsibilityArea String?
  status             String?
  positionTitle      String?
  departmentName     String?
  roleTitle          String?
  phone              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  userId       String? @unique
  companyId    String?
  departmentId String?
  positionId   String?
  managerId    String?

  user                 User?                  @relation("UserEmployeeProfile", fields: [userId], references: [id], onDelete: SetNull)
  company              Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  department           Department?            @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  position             Position?              @relation("EmployeePosition", fields: [positionId], references: [id], onDelete: SetNull)
  reports              Employee[]             @relation("EmployeeHierarchy")
  manager              Employee?              @relation("EmployeeHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  responsibleCustomers Customer[]             @relation("EmployeeResponsible")
  sales                Sale[]                 @relation("SaleEmployee")
  dailySalesSummaries  DailySalesSummary[]
  salesTargets         SalesTarget[]
  pointSummary         EmployeePointSummary?
  pointHistories       EmployeePointHistory[]
}

model Department {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  positions Position[]
  employees Employee[] @relation("EmployeeDepartment")
  users     User[]     @relation("DepartmentUsers")
}

model Position {
  id            String    @id @default(cuid())
  name          String
  description   String?
  level         Int       @default(1)
  isManagerial  Boolean   @default(false)
  departmentId  String?
  defaultRoleId String?
  deletedAt     DateTime?

  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  defaultRole Role?       @relation("RoleDefaultPositions", fields: [defaultRoleId], references: [id], onDelete: SetNull)
  employees   Employee[]  @relation("EmployeePosition")
  users       User[]      @relation("UserPosition")
}

model Role {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  permissions      RolePermission[]
  userRoles        UserRole[]
  defaultPositions Position[]       @relation("RoleDefaultPositions")
}

model Permission {
  id                  String             @id @default(cuid())
  key                 String             @unique
  name                String
  description         String?
  category            PermissionType
  menuPath            String?
  action              String?
  resource            String?
  defaultDataAccess   DataAccessLevel?
  defaultEditAccess   EditAccessLevel? // ขอบเขตการแก้ไขเริ่มต้น
  defaultDeleteAccess DeleteAccessLevel? // ขอบเขตการลบเริ่มต้น
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  rolePermissions RolePermission[]
  overrides       UserPermissionOverride[]
}

model RolePermission {
  id           String             @id @default(cuid())
  roleId       String
  permissionId String
  allow        Boolean            @default(true)
  dataAccess   DataAccessLevel? // ขอบเขตการมองเห็น
  editAccess   EditAccessLevel? // ขอบเขตการแก้ไข
  deleteAccess DeleteAccessLevel? // ขอบเขตการลบ
  createdAt    DateTime           @default(now())
  deletedAt    DateTime?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id         String    @id @default(cuid())
  userId     String
  roleId     String
  assignedBy String?
  assignedAt DateTime  @default(now())
  deletedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model UserPermissionOverride {
  id           String             @id @default(cuid())
  userId       String
  permissionId String
  allow        Boolean
  dataAccess   DataAccessLevel? // ขอบเขตการมองเห็น (override)
  editAccess   EditAccessLevel? // ขอบเขตการแก้ไข (override)
  deleteAccess DeleteAccessLevel? // ขอบเขตการลบ (override)
  reason       String?
  createdAt    DateTime           @default(now())
  deletedAt    DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model Customer {
  id                    String         @id @default(cuid())
  customerCode          String         @unique
  customerType          CustomerType
  name                  String
  prefix                String?
  firstName             String?
  birthDate             DateTime?
  lastName              String?
  email                 String?
  phone                 String?
  taxId                 String?        @map("tax_id")
  addressLine           String?        @map("address_line")
  province              String?
  region                String? // เก็บภาคของลูกค้า (เหนือ, กลาง, etc.)
  district              String?
  subdistrict           String?
  postalCode            String?        @map("postal_code")
  billingAddressLine    String?        @map("billing_address_line")
  billingProvince       String?        @map("billing_province")
  billingDistrict       String?        @map("billing_district")
  billingSubdistrict    String?        @map("billing_subdistrict")
  billingPostalCode     String?        @map("billing_postal_code")
  shippingAddressLine   String?        @map("shipping_address_line")
  shippingProvince      String?        @map("shipping_province")
  shippingDistrict      String?        @map("shipping_district")
  shippingSubdistrict   String?        @map("shipping_subdistrict")
  shippingPostalCode    String?        @map("shipping_postal_code")
  status                CustomerStatus @default(ACTIVE)
  contactPerson         String?        @map("contact_person")
  contactPhone          String?        @map("contact_phone")
  contactEmail          String?        @map("contact_email")
  notes                 String?
  latitude              String?
  longitude             String?
  relationshipScore     Int?
  parentDealerId        String?
  responsibleEmployeeId String?

  // SUBDEALER specific fields
  receiveFromDealer      String?
  mainCompetitor         String?
  areaCrops              String?
  averageMonthlyPurchase String?
  mainProductSold        String[]
  brandsSold             String[]
  areaType               String?

  // FARMER specific fields - stored as JSON
  farmPlots Json?

  // BROKER specific fields
  cropTypes             String?
  currentYield          String?
  farmerCount           String?
  plotCount             String?
  totalAreaRai          String?
  harvestPerYear        String?
  creditDays            String?
  chemicalValuePerCycle String?
  chemicalQtyPerCycle   String?
  regularShops          String?
  serviceTypes          String?
  usedBrands            String?

  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  images                CustomerImage[]
  creditLimits          CreditLimit[]
  temporaryCreditLimits TemporaryCreditLimit[]
  parentDealer          Customer?                 @relation("ParentDealer", fields: [parentDealerId], references: [id], onDelete: SetNull)
  subDealers            Customer[]                @relation("ParentDealer")
  responsibleEmployee   Employee?                 @relation("EmployeeResponsible", fields: [responsibleEmployeeId], references: [id], onDelete: SetNull)
  sales                 Sale[]                    @relation("SaleCustomer")
  dailySalesSummaries   DailySalesSummary[]
  salesTargets          SalesTargetStore[]
  shippingCompanies     CustomerShippingCompany[]
  addresses             CustomerAddress[]
  contacts              CustomerContact[]
}

model CustomerAddress {
  id          String   @id @default(cuid())
  customerId  String
  addressLine String?
  province    String?
  district    String?
  subdistrict String?
  postalCode  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  firstName  String?
  lastName   String?
  phone      String?
  email      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CreditLimit {
  id              String            @id @default(cuid())
  customerId      String
  limitAmount     Decimal           @db.Decimal(15, 2)
  promoAmount     Decimal?          @db.Decimal(15, 2)
  usedAmount      Decimal           @default(0) @db.Decimal(15, 2)
  availableAmount Decimal           @default(0) @db.Decimal(15, 2)
  status          CreditLimitStatus @default(ACTIVE)
  effectiveDate   DateTime
  expiryDate      DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  notes           String?
  createdById     String?           @map("created_by_id")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  // Temporary credit tracking
  temporaryCreditAmount     Decimal?  @default(0) @db.Decimal(15, 2)
  temporaryCreditExpiryDate DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model TemporaryCreditLimit {
  id              String                @id @default(cuid())
  customerId      String
  requestedAmount Decimal               @db.Decimal(15, 2)
  expiryDate      DateTime
  notes           String?
  status          TemporaryCreditStatus @default(PENDING)
  rejectionReason String?
  requestedById   String?
  requestedAt     DateTime              @default(now())
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?

  // Track which credit limit this was applied to
  appliedToCreditLimitId String?
  isReverted             Boolean   @default(false)
  revertedAt             DateTime?

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  requestedBy User?    @relation("TemporaryCreditRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy  User?    @relation("TemporaryCreditApprover", fields: [approvedById], references: [id], onDelete: SetNull)
}

// ==========================================
// SHIPPING COMPANIES
// ==========================================

model ShippingCompany {
  id          String                @id @default(cuid())
  name        String // ชื่อบริษัทขนส่ง
  phone       String? // เบอร์โทร
  address     String? // ที่อยู่บริษัทขนส่ง
  addressLine String? // บ้านเลขที่, ถนน
  province    String?
  district    String?
  subdistrict String?
  postalCode  String?
  notes       String? // หมายเหตุ
  status      ShippingCompanyStatus @default(ACTIVE) // สถานะการใช้งาน
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  deletedAt   DateTime? // Soft delete

  customers CustomerShippingCompany[] // ลูกค้าที่ใช้บริการขนส่ง
  sales     Sale[]                    @relation("SaleShippingCompany") // การขายที่ใช้บริษัทขนส่งนี้
}

// Junction table สำหรับความสัมพันธ์ Many-to-Many ระหว่าง Customer และ ShippingCompany
model CustomerShippingCompany {
  id                String   @id @default(cuid())
  customerId        String
  shippingCompanyId String
  createdAt         DateTime @default(now())

  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shippingCompany ShippingCompany @relation(fields: [shippingCompanyId], references: [id], onDelete: Cascade)

  @@unique([customerId, shippingCompanyId])
  @@index([customerId])
  @@index([shippingCompanyId])
}

// หมวดสินค้า (Product Category)
model ProductCategory {
  id          String    @id @default(cuid())
  code        String // รหัสหมวดสินค้า
  description String // คำอธิบายหมวดสินค้า
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  productGroups TradeNameGroup[]
  products      Product[] // Products in this category
}

// กลุ่มชื่อการค้า (Trade Name Group) - เดิมชื่อ "กลุ่มสินค้า"
model TradeNameGroup {
  id          String    @id @default(cuid())
  code        String    @unique // รหัสกลุ่มชื่อการค้า
  description String // คำอธิบายกลุ่มชื่อการค้า
  categoryId  String? // FK to ProductCategory
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

// ประเภท (ABC Code) (Product ABC Types)
model ProductABCTypes {
  id          String    @id @default(cuid())
  code        String   // รหัสประเภทสินค้า
  name        String // ชื่อประเภทสินค้า
  description String? // รายละเอียดประเภทสินค้า
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  products Product[]
}

// หน่วยนับ (Unit)
model Unit {
  id          String    @id @default(cuid())
  code        String    @unique // รหัสหน่วยนับ
  description String // คำอธิบายหน่วยนับ
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

// แบรนด์สินค้า (Brand)
model Brand {
  id          String    @id @default(cuid())
  code        String    @unique // รหัสแบรนด์
  description String // คำอธิบายแบรนด์
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model Plant {
  id                   String    @id @default(cuid())
  code                 String    @unique // รหัสพืช
  name                 String // ชื่อพืช
  abbreviation         String? // ตัวย่อพืช
  group                String? // กลุ่มพืช
  recommendedMedicines String? // ใช้กับตัวยาที่แนะนำ
  description          String? // คำอธิบายพืช
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  @@index([code])
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Product {
  id                     String        @id @default(cuid())
  productCode            String        @unique
  name                   String
  commonName             String?
  unit                   String?
  productGroup           String? // กลุ่มชื่อการค้า (Trade Name Group)
  brand                  String?
  packageSize            Decimal?      @db.Decimal(15, 3)
  packageSizeUnit        String?
  packageSizePerBox      Decimal?      @db.Decimal(15, 3)
  totalPackageSizePerBox Decimal?      @db.Decimal(15, 3)
  status                 ProductStatus @default(ACTIVE)
  usedForPlants          String[]
  salesPoint             String?
  properties             String?
  price                  Decimal?      @db.Decimal(15, 2)
  cartonPrice            Decimal?      @db.Decimal(15, 2)
  promotionBudget        Decimal?      @db.Decimal(15, 2)
  pointPerUnit           Int           @default(0)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  deletedAt              DateTime?

  // Category and ABC Type relations
  categoryId       String? // FK to ProductCategory (หมวดสินค้า)
  productABCTypeId String? // FK to ProductABCTypes (ประเภท (ABC Code))
  category         ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  productABCType   ProductABCTypes? @relation(fields: [productABCTypeId], references: [id], onDelete: SetNull)

  images               ProductImage[]
  promotionItems       ProductPromotionItem[]
  freeItems            ProductFreeItem[]
  stockLots            ProductStockLot[]
  saleItems            SaleItem[]             @relation("SaleItemProduct")
  stock                ProductStock?
  dailySalesSummaries  DailySalesSummary[]
  salesTargets         ProductSalesTarget[]   @relation("ProductSalesTargets")
  detailedSalesTargets SalesTargetItem[]
  chemicalGroup        String? // กลุ่มสินค้า (Product Group) - เดิมชื่อ "กลุ่มสาร"
  pointHistories       EmployeePointHistory[]

  parentId String?
  parent   Product?  @relation("ProductChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children Product[] @relation("ProductChildren")
}

// กลุ่มสินค้า (Product Group) - เดิมชื่อ "กลุ่มสาร"
model ProductGroup {
  id           String    @id @default(cuid())
  code         String    @unique // รหัสกลุ่มสินค้า
  name         String    @default("") // ชื่อกลุ่มสินค้า
  abbreviation String? // ตัวย่อกลุ่มสินค้า
  description  String? // คำอธิบายกลุ่มสินค้า
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

model ProductStock {
  id                String   @id @default(cuid())
  productId         String   @unique
  physicalBalance   Int      @default(0) // Total items in warehouse (Available + Reserved)
  reservedQuantity  Int      @default(0) // Allocated to active orders
  availableQuantity Int      @default(0) // Ready to sell (Physical - Reserved)
  updatedAt         DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CustomerImage {
  id         String   @id @default(cuid())
  customerId String
  url        String
  filename   String
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  filename  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductFreeItem {
  id          String   @id @default(cuid())
  productId   String
  purchaseQty Int
  freeQty     Int
  netPrice    Decimal? @db.Decimal(15, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductPromotionItem {
  id        String   @id @default(cuid())
  productId String
  name      String
  quantity  Int
  price     Decimal? @db.Decimal(15, 2)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductStockLot {
  id              String    @id @default(cuid())
  productId       String
  lotNumber       String
  quantity        Int
  initialQuantity Int       @default(0)
  importDate      DateTime
  expiryDate      DateTime?
  storageLocation String?
  notes           String?
  isUsed          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItemLots SaleItemLot[] // การใช้งาน LOT นี้ในการขาย
}

enum SaleStatus {
  PENDING // รอดำเนินการ
  PENDING_APPROVAL // รออนุมัติ
  APPROVED // อนุมัติแล้ว
  REJECTED // ไม่อนุมัติ
  AWAITING_PAYMENT // รอดำเนินการชำระเงิน
  PAID // ชำระเงินแล้ว
  AWAITING_DELIVERY // รอดำเนินการจัดส่งสินค้า
  DELIVERED // ระหว่างขนส่ง
  DELIVERY_COMPLETED // ส่งเสร็จแล้ว
  EXPIRED // หมดอายุ (ไม่ระบุวันส่ง + เลย 3 วัน)
  OVERDUE // เลยกำหนด (อัปเดตวันส่งเกิน 3 ครั้ง)
  WAITING_FOR_CORRECTION // รอแก้ไข
  CANCELLED // ยกเลิก
  COMPLETED // เสร็จสิ้น
}

enum PaymentTerm {
  CREDIT_90 // ส่งสินค้าก่อน (เครดิต 90 วัน)
  CASH_7 // ชำระเงินสด (เครดิต 7 วัน)
  PREPAID // ชำระเงินก่อนส่งสินค้า (โอนเงินก่อนส่งสินค้า)
  CREDIT_OVER_90 // ส่งสินค้าก่อน (เครดิตมากกว่า 90 วัน) - Admin only
}

model Sale {
  id          String      @id @default(cuid()) // รหัสเอกสารการขาย (Primary Key)
  saleNumber  String      @unique // เลขที่เอกสาร (เช่น SN-202310-001)
  customerId  String // รหัสลูกค้า
  employeeId  String // รหัสพนักงานขายที่ดูแล (เซลส์)
  status      SaleStatus  @default(PENDING) // สถานะบันทึกการขาย (เช่น รออนุมัติ, อนุมัติแล้ว)
  paymentTerm PaymentTerm // เงื่อนไขการชำระเงิน (เช่น เงินสด, เครดิต)

  // Credit information (ข้อมูลเครดิต)
  creditDays            Int? // จำนวนวันเครดิต (เช่น 30, 60, 90 วัน)
  creditDueDate         DateTime? // วันครบกำหนดชำระเงิน
  usePromotionalCredit  Boolean   @default(false) // ใช้เครดิตโปรโมชั่นหรือไม่
  promotionalCreditUsed Decimal?  @db.Decimal(15, 2) // จำนวนวงเงินเครดิตโปรโมชั่นที่ถูกใช้งาน

  // Dates (ข้อมูลวันที่)
  saleDate              DateTime // วันที่ทำเอกสารการขาย
  requestedDeliveryDate DateTime? // วันที่ลูกค้าต้องการให้จัดส่งสินค้า
  deliveryDate          DateTime? // วันที่กำหนดส่งสินค้า
  actualDeliveryDate    DateTime? // วันที่จัดส่งสินค้าสำเร็จจริง
  deliveryUpdateCount   Int       @default(0) // จำนวนครั้งที่อัปเดตวันส่ง
  maxDeliveryUpdates    Int       @default(3) // จำนวนครั้งสูงสุดที่อนุญาตให้แก้ไขวันส่ง
  isDeliveryLocked      Boolean   @default(false) // ล็อคการแก้ไขวันที่จัดส่ง/ใบสั่งซื้อ
  orderExpiryDate       DateTime? // วันที่ใบสั่งซื้อหมดอายุ (เช่น อนุมัติ + 3 วัน)
  lastDeliveryUpdate    DateTime? // วันที่อัปเดตวันส่งล่าสุด
  deliveryMethod        String? // วิธีการจัดส่ง (เช่น SALES_DELIVERY พนักงานส่ง, CUSTOMER_PICKUP ลูกค้ารับเอง)
  pickupCompanyId       String? // รหัสสถานที่รับสินค้าเอง (FK to Company)
  shippingCompanyId     String? // รหัสบริษัทขนส่งที่เลือก (FK to ShippingCompany)

  // Addresses (ข้อมูลที่อยู่เดิม - อาจจะยกเลิกใช้ในอนาคต)
  useCustomShipping Boolean @default(false) // ระบุว่ากรอกที่อยู่จัดส่งเองหรือไม่ (ไม่ได้ดึงจากประวัติลูกค้า)
  selectedAddressId String? // รหัสที่อยู่จัดส่งที่เลือกจากประวัติที่อยู่ของลูกค้า

  // Detailed Addresses & Snapshots (ข้อมูลที่อยู่แบบละเอียดและ Snapshot)
  saleAddress SaleAddress?

  // Amounts (จำนวนเงินและการคำนวณ)
  subtotalAmount        Decimal @db.Decimal(15, 2) // ยอดรวมสินค้า (ก่อนหักส่วนลด หรือบวกเพิ่ม)
  shippingCost          Decimal @default(0) @db.Decimal(15, 2) // ค่าจัดส่ง
  otherCosts            Decimal @default(0) @db.Decimal(15, 2) // ค่าใช้จ่ายอื่นๆ เพิ่มเติม
  otherCostsDescription String? // คำอธิบายค่าใช้จ่ายอื่นๆ
  totalAmount           Decimal @db.Decimal(15, 2) // ยอดรวมสุทธิ (Net Total)

  // External reference (เลขอ้างอิง)
  saleOrderRef String? // เลขที่เอกสารอ้างอิง (เช่น PO จากลูกค้า, Ref จากระบบอื่น)

  // Notes (หมายเหตุ)
  notes String? // หมายเหตุทั่วไป (Internal Note สำหรับเซลส์หรือออฟฟิศ)

  // Payment information (ข้อมูลการชำระเงิน)
  paymentDate  DateTime? // วันที่ชำระเงินจริง
  paymentNotes String? // หมายเหตุการรับชำระเงิน

  // Delivery notes (หมายเหตุจัดส่ง)
  deliveryNotes String? // หมายเหตุการจัดส่ง (ข้อความถึงคนขับรถ หรือบริษัทขนส่ง)

  // Approval information (ข้อมูลการอนุมัติ)
  approvedById    String? // รหัสผู้ทำการอนุมัติเอกสาร
  approvedAt      DateTime? // วันและเวลาที่เอกสารได้รับการอนุมัติ
  rejectionReason String? // เหตุผลที่ไม่อนุมัติ (ปัดตก)
  rejectedAt      DateTime? // วันและเวลาที่ถูกไม่อนุมัติ

  // Audit fields (ข้อมูลบันทึกระบบ)
  createdById String // รหัสผู้สร้างบันทึกการขาย
  createdAt   DateTime  @default(now()) // วันและเวลาที่สร้างเอกสาร
  updatedAt   DateTime  @updatedAt // วันและเวลาที่แก้ไขบันทึกล่าสุด
  deletedAt   DateTime? // วันเวลาที่ลบเอกสาร (Soft Delete)

  // Relations
  customer        Customer         @relation("SaleCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  employee        Employee         @relation("SaleEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy       User             @relation("SaleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy      User?            @relation("SaleApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  pickupCompany   Company?         @relation("SalePickupCompany", fields: [pickupCompanyId], references: [id], onDelete: SetNull)
  shippingCompany ShippingCompany? @relation("SaleShippingCompany", fields: [shippingCompanyId], references: [id], onDelete: SetNull)

  items          SaleItem[]
  statusHistory  SaleStatusHistory[]
  pointHistories EmployeePointHistory[]

  @@index([customerId, saleDate])
  @@index([employeeId, saleDate])
}

model SaleItem {
  id        String @id @default(cuid())
  saleId    String
  productId String

  // Product Snapshot (ข้อมูลสินค้าย้อนหลัง)
  productCode            String?
  name                   String?
  commonName             String?
  unit                   String?
  productGroup           String?
  brand                  String?
  packageSize            Decimal? @db.Decimal(15, 3)
  packageSizeUnit        String?
  packageSizePerBox      Decimal? @db.Decimal(15, 3)
  totalPackageSizePerBox Decimal? @db.Decimal(15, 3)
  price                  Decimal? @db.Decimal(15, 2)
  cartonPrice            Decimal? @db.Decimal(15, 2)
  promotionBudget        Decimal? @db.Decimal(15, 2)
  pointPerUnit           Int?
  productChain           String?

  quantity      Int
  unitPrice     Decimal  @db.Decimal(15, 2)
  originalPrice Decimal  @db.Decimal(15, 2)
  priceModified Boolean  @default(false)
  totalPrice    Decimal  @db.Decimal(15, 2)
  stockAtSale   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sale           Sale                  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product               @relation("SaleItemProduct", fields: [productId], references: [id], onDelete: Restrict)
  lotAllocations SaleItemLot[] // LOT ที่ใช้สำหรับสินค้านี้
  pointHistory   EmployeePointHistory?
}

model EmployeePointHistory {
  id           String   @id @default(cuid())
  employeeId   String
  saleId       String
  saleItemId   String
  productId    String
  quantity     Int
  pointPerUnit Int
  totalPoints  Int
  createdAt    DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleItem SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([saleItemId])
  @@index([employeeId, createdAt])
  @@index([saleId])
}

model EmployeePointSummary {
  employeeId  String   @id
  totalPoints Int      @default(0)
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// เก็บข้อมูลว่า SaleItem แต่ละรายการใช้ LOT ไหนบ้าง
model SaleItemLot {
  id         String   @id @default(cuid())
  saleItemId String
  lotId      String
  quantity   Int // จำนวนที่ใช้จาก LOT นี้
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  saleItem SaleItem        @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  lot      ProductStockLot @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@unique([saleItemId, lotId])
  @@index([saleItemId])
  @@index([lotId])
}

// ==========================================
// SALE ADDRESS
// ==========================================
model SaleAddress {
  id     String @id @default(cuid())
  saleId String @unique

  // Reference IDs (อ้างอิง Master Data)
  companyAddressId          String? // ที่อยู่บริษัทเรา (ออกเอกสาร)
  billingCustomerAddressId  String? // ที่อยู่วางบิล (ของลูกค้า)
  shippingCustomerAddressId String? // ที่อยู่จัดส่ง (ของลูกค้า)
  pickupCompanyAddressId    String? // ที่อยู่รับสินค้า (สาขา/โกดังเรา)
  shippingCompanyAddressId  String? // ที่อยู่บริษัทขนส่ง (สำนักงาน/จุดรับ)

  // ที่อยู่ลูกค้า
  company_name        String?
  company_phone       String?
  address_line        String?
  address_province    String?
  address_district    String?
  address_subdistrict String?
  address_code        String?
  company_note        String?

  // ที่อยู่วางบิล
  billing_address_line String?
  billing_province     String?
  billing_district     String?
  billing_subdistrict  String?
  billing_postal_code  String?
  billing_note         String?

  // ที่อยู่จัดส่งสินค้า
  shipping_address_line String?
  shipping_province     String?
  shipping_district     String?
  shipping_subdistrict  String?
  shipping_postal_code  String?
  shipping_note         String?

  // ที่อยู่รับสินค้า
  receiving_name         String?
  receiving_phone        String?
  receiving_address_line String?
  receiving_province     String?
  receiving_district     String?
  receiving_subdistrict  String?
  receiving_postal_code  String?
  receiving_note         String?

  // ที่อยู่ขนส่ง
  sender_name        String?
  sender_phone       String?
  sender_line        String?
  sender_province    String?
  sender_district    String?
  sender_subdistrict String?
  sender_postal_code String?
  sender_note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model SaleStatusHistory {
  id          String     @id @default(cuid())
  saleId      String
  status      SaleStatus
  notes       String?
  changedById String
  changedAt   DateTime   @default(now())

  sale      Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  changedBy User @relation("StatusHistoryUser", fields: [changedById], references: [id], onDelete: Restrict)
}

model DailySalesSummary {
  id    String   @id @default(cuid())
  date  DateTime @db.Date // เก็บวันที่อย่างเดียวเพื่อการ Group ที่แม่นยำ
  year  Int // Indexed Column สำหรับกรองปีอย่างรวดเร็ว
  month Int // Indexed Column

  // Dimensions (มิติข้อมูล)
  customerId   String
  employeeId   String
  productId    String
  brand        String? // De-normalized: เก็บชื่อแบรนด์ไว้เลยเพื่อลดการ Join
  productGroup String? // De-normalized: เก็บกลุ่มสินค้า (ตรงกับ Product.productGroup)

  // Metrics (ตัววัดผล)
  quantity          Int     @default(0)
  totalAmount       Decimal @default(0) @db.Decimal(15, 2)
  orderCount        Int     @default(0) // จำนวนบิลที่เกิดขึ้นในวันนี้
  totalVolumeLiters Decimal @default(0) @db.Decimal(15, 3) // ปริมาณรวมเป็นลิตร (แปลงจาก packageSize × quantity)

  // Audit
  updatedAt DateTime @updatedAt

  // Relations
  customer Customer @relation(fields: [customerId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([date, customerId, employeeId, productId]) // ป้องกันข้อมูลซ้ำซ้อน
  // Composite Indexes สำคัญมากสำหรับความเร็ว
  @@index([year, customerId]) // สำหรับรายงานลูกค้าแยกรายปี
  @@index([year, employeeId]) // สำหรับรายงานเซลล์แยกรายปี
  @@index([date])
}

// ==========================================
// SALES TARGETS
// ==========================================

// เป้ายอดขายรายภาค
model RegionSalesTarget {
  id           String  @id @default(cuid())
  region       String // ภาคเหนือ, ภาคตะวันออกเฉียงเหนือ, ภาคตะวันตก, ภาคกลาง, ภาคใต้
  year         Int // ปี พ.ศ. หรือ ค.ศ.
  month        Int? // เดือน (1-12), null = เป้าหมายรายปี
  targetAmount Decimal @db.Decimal(15, 2) // เป้ายอดขาย (บาท)
  notes        String? // หมายเหตุเพิ่มเติม

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([region, year, month]) // ป้องกันข้อมูลซ้ำซ้อน
  @@index([year, month])
  @@index([region])
}

// เป้ายอดขายรายกลุ่มสินค้า
model ProductGroupSalesTarget {
  id           String  @id @default(cuid())
  productGroup String // กลุ่มสินค้า (ตรงกับ PRODUCT_GROUP_OPTIONS)
  year         Int // ปี พ.ศ. หรือ ค.ศ.
  month        Int? // เดือน (1-12), null = เป้าหมายรายปี
  targetAmount Decimal @db.Decimal(15, 2) // เป้ายอดขาย (บาท)
  notes        String? // หมายเหตุเพิ่มเติม

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([productGroup, year, month]) // ป้องกันข้อมูลซ้ำซ้อน
  @@index([year, month])
  @@index([productGroup])
}

// เป้ายอดขายรวมรายเดือน/รายปี
model MonthlySalesTarget {
  id           String  @id @default(cuid())
  year         Int // ปี พ.ศ. หรือ ค.ศ.
  month        Int? // เดือน (1-12), null = เป้าหมายรายปี
  targetAmount Decimal @db.Decimal(15, 2) // เป้ายอดขาย (บาท)
  notes        String? // หมายเหตุเพิ่มเติม

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([year, month]) // ป้องกันข้อมูลซ้ำซ้อน
  @@index([year])
}

// เป้ายอดขายรายสินค้า
model ProductSalesTarget {
  id           String  @id @default(cuid())
  productId    String // FK to Product
  year         Int // ปี พ.ศ. หรือ ค.ศ.
  month        Int? // เดือน (1-12), null = เป้าหมายรายปี
  targetAmount Decimal @db.Decimal(15, 2) // เป้ายอดขาย (บาท)
  notes        String? // หมายเหตุเพิ่มเติม

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  product Product @relation("ProductSalesTargets", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, year, month]) // ป้องกันข้อมูลซ้ำซ้อน
  @@index([year, month])
  @@index([productId])
}

// ==========================================
// LOGGING SYSTEM
// ==========================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  APPROVE
  REJECT
  EXPORT
  IMPORT
  LOGIN
  LOGOUT
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGE
  PASSWORD_RESET
  PERMISSION_CHANGE
  ROLE_CHANGE
  ADMIN_ACTION
  DATA_EXPORT
  SUSPICIOUS_ACTIVITY
  SESSION_EXPIRED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
}

enum LogSeverity {
  DEBUG
  INFO
  WARN
  ERROR
  CRITICAL
}

model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())

  // Who performed the action
  userId    String?
  userEmail String?
  userName  String?
  ipAddress String?
  userAgent String?

  // What action was performed
  action     AuditAction
  entityType String // Sale, Customer, CreditLimit, User, Product, etc.
  entityId   String?
  entityName String? // Human-readable name (e.g., customer name, sale number)

  // Data Changes
  oldValue      Json? // State before change
  newValue      Json? // State after change
  changedFields String[] // List of changed field names

  // Context
  module    String? // sales, customers, products, users, etc.
  requestId String? // Correlation ID for tracing
  sessionId String?
  endpoint  String? // API endpoint that was called
  method    String? // HTTP method (GET, POST, PUT, DELETE)

  // Result
  success      Boolean @default(true)
  errorMessage String?
  duration     Int? // Request duration in milliseconds

  // Optional relation to User
  user User? @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, timestamp])
  @@index([entityType, entityId])
  @@index([entityType, timestamp])
  @@index([action, timestamp])
  @@index([timestamp])
  @@index([module, timestamp])
}

model SecurityLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())

  // Event Information
  eventType SecurityEventType
  severity  LogSeverity       @default(INFO)
  message   String?

  // Who triggered the event
  userId    String?
  userEmail String?
  userName  String?

  // Request Information
  ipAddress   String
  userAgent   String?
  geoLocation String? // Country/City if available

  // Session Information
  sessionId String?
  requestId String?

  // Event Details
  details         Json? // Additional context
  targetUserId    String? // For admin actions affecting other users
  targetUserEmail String?

  // Result
  success       Boolean @default(true)
  failureReason String?

  // Risk Assessment
  riskScore Int? // 0-100, higher = more risky
  isBlocked Boolean @default(false)

  // Rate Limiting
  attemptCount Int @default(1) // For tracking repeated failures

  // Optional relation to User
  user       User? @relation("SecurityLogUser", fields: [userId], references: [id], onDelete: SetNull)
  targetUser User? @relation("SecurityLogTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([userId, timestamp])
  @@index([eventType, timestamp])
  @@index([ipAddress, timestamp])
  @@index([severity, timestamp])
  @@index([timestamp])
  @@index([riskScore])
}

model ApplicationLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())

  // Log Information
  level   LogSeverity
  message String

  // Context
  module       String? // Component/module name
  functionName String?

  // Request Context
  requestId String?
  userId    String?
  sessionId String?

  // Error Details
  errorName    String?
  errorMessage String?
  stackTrace   String? @db.Text

  // Additional Data
  metadata Json?

  // Performance
  duration Int? // milliseconds

  @@index([level, timestamp])
  @@index([module, timestamp])
  @@index([requestId])
  @@index([timestamp])
}

// ==========================================
// NOTIFICATIONS
// ==========================================

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  APPROVED
  REJECTED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

// ==========================================
// NEW SALES TARGETS (DETAILED)
// ==========================================

// เป้าหมายการขาย: 1 record ต่อ 1 เดือน ต่อ 1 พนักงาน
model SalesTarget {
  id         String @id @default(cuid())
  year       Int
  month      Int
  employeeId String // พนักงาน

  employee Employee              @relation(fields: [employeeId], references: [id])
  stores   SalesTargetStore[]
  history  SalesTargetHistory[] // ประวัติการเปลี่ยนแปลง

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([year, month, employeeId]) // 1 เป้าต่อ 1 พนักงาน ต่อ 1 เดือน
  @@index([year, month])
  @@index([employeeId])
}

// ร้านค้าในเป้าหมาย: 1 ร้าน ต่อ 1 เป้าหมาย
model SalesTargetStore {
  id            String @id @default(cuid())
  salesTargetId String
  customerId    String // ร้านค้า

  salesTarget SalesTarget       @relation(fields: [salesTargetId], references: [id], onDelete: Cascade)
  customer    Customer          @relation(fields: [customerId], references: [id])
  items       SalesTargetItem[]

  @@unique([salesTargetId, customerId]) // ไม่ซ้ำร้านค้าในเป้าหมายเดียวกัน
  @@index([salesTargetId])
  @@index([customerId])
}

// สินค้าในร้านค้า: หลายสินค้าต่อ 1 ร้าน
model SalesTargetItem {
  id                 String  @id @default(cuid())
  salesTargetStoreId String
  productId          String
  pricePerBox        Decimal @default(0) @db.Decimal(15, 2)
  qtyPerBox          Int     @default(0)
  targetAmount       Decimal @default(0) @db.Decimal(15, 2)

  salesTargetStore SalesTargetStore @relation(fields: [salesTargetStoreId], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [productId], references: [id])

  @@index([salesTargetStoreId])
  @@index([productId])
}

// ==========================================
// SALES TARGET HISTORY (Audit Trail)
// ==========================================

enum SalesTargetChangeType {
  CREATED  // สร้างใหม่
  UPDATED  // แก้ไข
  DELETED  // ลบ
}

// ประวัติการเปลี่ยนแปลงเป้าหมายการขาย
// เก็บ snapshot แบบ JSON ก่อน/หลังการเปลี่ยนแปลง
model SalesTargetHistory {
  id            String                @id @default(cuid())
  salesTargetId String // FK ไปยัง SalesTarget ที่ถูกแก้ไข
  changeType    SalesTargetChangeType // CREATE / UPDATE / DELETE
  changedById   String // ใครแก้ไข (FK to User)
  changedAt     DateTime              @default(now())

  // Snapshot ข้อมูลเต็ม (JSON) เพื่อให้ดูย้อนหลังได้โดยไม่ต้อง JOIN
  snapshotBefore Json? // ข้อมูลก่อนแก้ไข (null เมื่อ CREATE)
  snapshotAfter  Json? // ข้อมูลหลังแก้ไข (null เมื่อ DELETE)

  // สรุปการเปลี่ยนแปลงเพื่อแสดงใน UI ได้รวดเร็ว
  changeSummary String? // เช่น "แก้ไขสินค้า 3 รายการ, เพิ่มร้านค้า 1 แห่ง"

  // Relations
  salesTarget SalesTarget @relation(fields: [salesTargetId], references: [id], onDelete: Cascade)
  changedBy   User        @relation("SalesTargetHistoryUser", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([salesTargetId, changedAt])
  @@index([changedById, changedAt])
  @@index([changedAt])
}
