// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum PermissionType {
  MENU
  ACTION
  DATA
}

enum DataAccessLevel {
  VIEW_OWN
  VIEW_DEPARTMENT
  VIEW_ALL
}

enum CustomerType {
  DEALER
  SUBDEALER
  FARMER
  BROKER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CreditLimitStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum TemporaryCreditStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  password     String
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  departmentId String?
  positionId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department                    Department?              @relation("DepartmentUsers", fields: [departmentId], references: [id], onDelete: SetNull)
  position                      Position?                @relation("UserPosition", fields: [positionId], references: [id], onDelete: SetNull)
  employeeProfile               Employee?                @relation("UserEmployeeProfile")
  userRoles                     UserRole[]
  permissionOverrides           UserPermissionOverride[]
  requestedTemporaryCreditLimits TemporaryCreditLimit[]  @relation("TemporaryCreditRequester")
  approvedTemporaryCreditLimits  TemporaryCreditLimit[]  @relation("TemporaryCreditApprover")
  createdSales                  Sale[]                   @relation("SaleCreator")
  approvedSales                 Sale[]                   @relation("SaleApprover")
  saleStatusChanges             SaleStatusHistory[]      @relation("StatusHistoryUser")
}

model Company {
  id          String        @id @default(cuid())
  name        String
  companyCode String?       @unique @map("company_code")
  shortName   String?       @map("short_name")
  email       String?       @unique
  phone       String?
  taxId       String?       @map("tax_id")
  addressLine String?       @map("address_line")
  province    String?
  district    String?
  subdistrict String?
  postalCode  String?
  status      CompanyStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  employees   Employee[]
  pickupSales Sale[]     @relation("SalePickupCompany")
}

model Employee {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  // Extended employee fields
  prefix             String?
  firstName          String?
  lastName           String?
  employeeCode       String?
  birthDate          DateTime?
  addressLine        String?   @map("address_line")
  province           String?
  district           String?
  subdistrict        String?
  postalCode         String?
  responsibilityArea String?
  status             String?
  positionTitle      String?
  departmentName     String?
  roleTitle          String?
  phone              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  userId       String? @unique
  companyId    String?
  departmentId String?
  positionId   String?
  managerId    String?

  user                 User?       @relation("UserEmployeeProfile", fields: [userId], references: [id], onDelete: SetNull)
  company              Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  department           Department? @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  position             Position?   @relation("EmployeePosition", fields: [positionId], references: [id], onDelete: SetNull)
  reports              Employee[]  @relation("EmployeeHierarchy")
  manager              Employee?   @relation("EmployeeHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  responsibleCustomers Customer[]  @relation("EmployeeResponsible")
  sales                Sale[]      @relation("SaleEmployee")
}

model Department {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  positions Position[]
  employees Employee[] @relation("EmployeeDepartment")
  users     User[]     @relation("DepartmentUsers")
}

model Position {
  id            String    @id @default(cuid())
  name          String
  description   String?
  level         Int       @default(1)
  isManagerial  Boolean   @default(false)
  departmentId  String?
  defaultRoleId String?
  deletedAt     DateTime?

  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  defaultRole Role?       @relation("RoleDefaultPositions", fields: [defaultRoleId], references: [id], onDelete: SetNull)
  employees   Employee[]  @relation("EmployeePosition")
  users       User[]      @relation("UserPosition")
}

model Role {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  permissions      RolePermission[]
  userRoles        UserRole[]
  defaultPositions Position[]       @relation("RoleDefaultPositions")
}

model Permission {
  id                String           @id @default(cuid())
  key               String           @unique
  name              String
  description       String?
  category          PermissionType
  menuPath          String?
  action            String?
  resource          String?
  defaultDataAccess DataAccessLevel?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  rolePermissions RolePermission[]
  overrides       UserPermissionOverride[]
}

model RolePermission {
  id           String           @id @default(cuid())
  roleId       String
  permissionId String
  allow        Boolean          @default(true)
  dataAccess   DataAccessLevel?
  createdAt    DateTime         @default(now())
  deletedAt    DateTime?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id         String    @id @default(cuid())
  userId     String
  roleId     String
  assignedBy String?
  assignedAt DateTime  @default(now())
  deletedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model UserPermissionOverride {
  id           String           @id @default(cuid())
  userId       String
  permissionId String
  allow        Boolean
  dataAccess   DataAccessLevel?
  reason       String?
  createdAt    DateTime         @default(now())
  deletedAt    DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model Customer {
  id                    String         @id @default(cuid())
  customerCode          String         @unique
  customerType          CustomerType
  name                  String
  prefix                String?
  firstName             String?
  birthDate             DateTime?
  lastName              String?
  email                 String?
  phone                 String?
  taxId                 String?        @map("tax_id")
  addressLine           String?        @map("address_line")
  province              String?
  district              String?
  subdistrict           String?
  postalCode            String?        @map("postal_code")
  billingAddressLine    String?        @map("billing_address_line")
  billingProvince       String?        @map("billing_province")
  billingDistrict       String?        @map("billing_district")
  billingSubdistrict    String?        @map("billing_subdistrict")
  billingPostalCode     String?        @map("billing_postal_code")
  shippingAddressLine   String?        @map("shipping_address_line")
  shippingProvince      String?        @map("shipping_province")
  shippingDistrict      String?        @map("shipping_district")
  shippingSubdistrict   String?        @map("shipping_subdistrict")
  shippingPostalCode    String?        @map("shipping_postal_code")
  status                CustomerStatus @default(ACTIVE)
  contactPerson         String?        @map("contact_person")
  contactPhone          String?        @map("contact_phone")
  contactEmail          String?        @map("contact_email")
  notes                 String?
  latitude              String?
  longitude             String?
  relationshipScore     Int?
  parentDealerId        String?
  responsibleEmployeeId String?
  
  // SUBDEALER specific fields
  receiveFromDealer     String?
  mainCompetitor        String?
  areaCrops             String?
  averageMonthlyPurchase String?
  mainProductSold       String[]
  brandsSold            String[]
  areaType              String?
  
  // FARMER specific fields - stored as JSON
  farmPlots             Json?
  
  // BROKER specific fields
  cropTypes             String?
  currentYield          String?
  farmerCount           String?
  plotCount             String?
  totalAreaRai          String?
  harvestPerYear        String?
  creditDays            String?
  chemicalValuePerCycle String?
  chemicalQtyPerCycle   String?
  regularShops          String?
  serviceTypes          String?
  usedBrands            String?
  
  createdById           String?        @map("created_by_id")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?

  images                  CustomerImage[]
  creditLimits            CreditLimit[]
  temporaryCreditLimits   TemporaryCreditLimit[]
  parentDealer            Customer?     @relation("ParentDealer", fields: [parentDealerId], references: [id], onDelete: SetNull)
  subDealers              Customer[]    @relation("ParentDealer")
  responsibleEmployee     Employee?     @relation("EmployeeResponsible", fields: [responsibleEmployeeId], references: [id], onDelete: SetNull)
  sales                   Sale[]        @relation("SaleCustomer")
}

model CreditLimit {
  id              String            @id @default(cuid())
  customerId      String
  limitAmount     Decimal           @db.Decimal(15, 2)
  promoAmount     Decimal?          @db.Decimal(15, 2)
  usedAmount      Decimal           @default(0) @db.Decimal(15, 2)
  availableAmount Decimal           @default(0) @db.Decimal(15, 2)
  status          CreditLimitStatus @default(ACTIVE)
  effectiveDate   DateTime
  expiryDate      DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  notes           String?
  createdById     String?           @map("created_by_id")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  
  // Temporary credit tracking
  temporaryCreditAmount Decimal?    @default(0) @db.Decimal(15, 2)
  temporaryCreditExpiryDate DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model TemporaryCreditLimit {
  id                  String                 @id @default(cuid())
  customerId          String
  requestedAmount     Decimal                @db.Decimal(15, 2)
  expiryDate          DateTime
  notes               String?
  status              TemporaryCreditStatus  @default(PENDING)
  rejectionReason     String?
  requestedById       String?
  requestedAt         DateTime               @default(now())
  approvedById        String?
  approvedAt          DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  deletedAt           DateTime?
  
  // Track which credit limit this was applied to
  appliedToCreditLimitId String?
  isReverted          Boolean                @default(false)
  revertedAt          DateTime?

  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  requestedBy     User?    @relation("TemporaryCreditRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy      User?    @relation("TemporaryCreditApprover", fields: [approvedById], references: [id], onDelete: SetNull)
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Product {
  id                    String        @id @default(cuid())
  productCode           String        @unique
  name                  String
  commonName            String?
  unit                  String?
  productGroup          String?
  brand                 String?
  packageSize           String?
  packageSizePerBox     String?
  status                ProductStatus @default(ACTIVE)
  usedForPlants         String[]
  salesPoint            String?
  properties            String?
  price                 Decimal?      @db.Decimal(15, 2)
  promotionBudget       Decimal?      @db.Decimal(15, 2)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?

  images                ProductImage[]
  promotionItems        ProductPromotionItem[]
  freeItems             ProductFreeItem[]
  stockLots             ProductStockLot[]
  saleItems             SaleItem[]    @relation("SaleItemProduct")
}

model CustomerImage {
  id          String   @id @default(cuid())
  customerId  String
  url         String
  filename    String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  url         String
  filename    String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductFreeItem {
  id              String   @id @default(cuid())
  productId       String
  purchaseQty     Int
  freeQty         Int
  netPrice        Decimal? @db.Decimal(15, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductPromotionItem {
  id              String   @id @default(cuid())
  productId       String
  name            String
  quantity        Int
  price           Decimal? @db.Decimal(15, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductStockLot {
  id              String    @id @default(cuid())
  productId       String
  lotNumber       String
  quantity        Int
  importDate      DateTime
  expiryDate      DateTime?
  storageLocation String?
  notes           String?
  isUsed          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum SaleStatus {
  PENDING           // รอดำเนินการ
  APPROVED          // อนุมัติแล้ว
  REJECTED          // ไม่อนุมัติ
  AWAITING_PAYMENT  // รอดำเนินการชำระเงิน
  PAID              // ชำระเงินแล้ว
  AWAITING_DELIVERY // รอดำเนินการจัดส่งสินค้า
  DELIVERED         // จัดส่งแล้ว
  EXPIRED           // หมดอายุ
  CANCELLED         // ยกเลิก
  COMPLETED         // เสร็จสิ้น
}

enum PaymentTerm {
  CREDIT_90       // ส่งสินค้าก่อน (เครดิต 90 วัน)
  CASH_7          // ชำระเงินสด (เครดิต 7 วัน)
  PREPAID         // ชำระเงินก่อนส่งสินค้า (โอนเงินก่อนส่งสินค้า)
  CREDIT_OVER_90  // ส่งสินค้าก่อน (เครดิตมากกว่า 90 วัน) - Admin only
}

model Sale {
  id                    String      @id @default(cuid())
  saleNumber            String      @unique
  customerId            String
  employeeId            String
  status                SaleStatus  @default(PENDING)
  paymentTerm           PaymentTerm
  
  // Credit information
  creditDays            Int?
  creditDueDate         DateTime?
  usePromotionalCredit  Boolean     @default(false)
  promotionalCreditUsed Decimal?    @db.Decimal(15, 2)
  
  // Dates
  saleDate              DateTime
  requestedDeliveryDate DateTime?  // วันที่ต้องการของ
  deliveryDate          DateTime?
  actualDeliveryDate    DateTime?
  deliveryUpdateCount   Int         @default(0)
  deliveryMethod        String?     // SALES_DELIVERY or CUSTOMER_PICKUP
  pickupCompanyId       String?
  pickupCompany         Company?    @relation("SalePickupCompany", fields: [pickupCompanyId], references: [id], onDelete: SetNull)
  
  // Addresses
  billingAddress        String?
  shippingAddress       String?
  
  // Amounts
  subtotalAmount        Decimal     @db.Decimal(15, 2)
  shippingCost          Decimal     @default(0) @db.Decimal(15, 2)
  otherCosts            Decimal     @default(0) @db.Decimal(15, 2)
  otherCostsDescription String?
  totalAmount           Decimal     @db.Decimal(15, 2)
  
  // Notes
  notes                 String?
  
  // Payment information
  paymentDate           DateTime?
  paymentNotes          String?
  
  // Delivery notes
  deliveryNotes         String?
  
  // Approval information
  approvedById          String?
  approvedAt            DateTime?
  rejectionReason       String?
  rejectedAt            DateTime?
  
  // Audit fields
  createdById           String
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deletedAt             DateTime?
  
  // Relations
  customer              Customer    @relation("SaleCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  employee              Employee    @relation("SaleEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy             User        @relation("SaleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy            User?       @relation("SaleApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  
  items                 SaleItem[]
  statusHistory         SaleStatusHistory[]
}

model SaleItem {
  id                    String   @id @default(cuid())
  saleId                String
  productId             String
  quantity              Int
  unitPrice             Decimal  @db.Decimal(15, 2)
  originalPrice         Decimal  @db.Decimal(15, 2)
  priceModified         Boolean  @default(false)
  totalPrice            Decimal  @db.Decimal(15, 2)
  stockAtSale           Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  sale                  Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product               Product  @relation("SaleItemProduct", fields: [productId], references: [id], onDelete: Restrict)
}

model SaleStatusHistory {
  id              String     @id @default(cuid())
  saleId          String
  status          SaleStatus
  notes           String?
  changedById     String
  changedAt       DateTime   @default(now())
  
  sale            Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  changedBy       User       @relation("StatusHistoryUser", fields: [changedById], references: [id], onDelete: Restrict)
}
