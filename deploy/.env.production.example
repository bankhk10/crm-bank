# ===========================================
# Production Environment Configuration
# ===========================================
# สำหรับ Deploy แบบ Split Compose (db + app)
# Copy to: .env.production (git-ignored)
# IMPORTANT: ไม่ใส่ค่า secret จริงในไฟล์ตัวอย่างนี้!

# ===========================================
# PostgreSQL Database Configuration
# ===========================================
# ใช้ร่วมกันทั้ง db-compose และ app-compose
POSTGRES_USER=crm_admin
POSTGRES_PASSWORD=crm@dmin
POSTGRES_DB=crm

# ===========================================
# Authentication Configuration
# ===========================================
# Generate with: openssl rand -base64 64
AUTH_SECRET=asdsaddasdasdasdasdasdads
AUTH_TRUST_HOST=true

# ===========================================
# Application URL
# ===========================================
NEXTAUTH_URL=https://csone.cropsciences.co.th

# ===========================================
# Feature Flags
# ===========================================
NEXT_PUBLIC_SHOW_RANDOM_FILL=false

# ===========================================
# Node Environment
# ===========================================
NODE_ENV=production

# ===========================================
# Optional: Backup Configuration
# ===========================================
# BACKUP_RETENTION_DAYS=30
# BACKUP_S3_BUCKET=your-backup-bucket

# ===========================================
# Optional: Monitoring
# ===========================================
# SENTRY_DSN=your-sentry-dsn
