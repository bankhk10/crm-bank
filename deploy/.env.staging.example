# ===========================================
# CRM-Bank Staging Environment Configuration
# Domain: test-csone.cropsciences.co.th
# ===========================================
# Copy to: .env.staging (git-ignored)

# ===========================================
# PostgreSQL Database Configuration (Staging)
# ===========================================
POSTGRES_USER=crm_staging_admin
POSTGRES_PASSWORD=crm_staging_secure_password_here
POSTGRES_DB=crm_staging

# ===========================================
# Authentication Configuration
# ===========================================
# Generate with: openssl rand -base64 64
AUTH_SECRET=your-staging-auth-secret-generate-with-openssl
AUTH_TRUST_HOST=true

# ===========================================
# Application URL
# ===========================================
NEXTAUTH_URL=https://test-csone.cropsciences.co.th

# ===========================================
# Feature Flags
# ===========================================
NEXT_PUBLIC_SHOW_RANDOM_FILL=true
ACTIVITY_PLAN_TEST_MODE=true

# ===========================================
# Cloudflare R2 Storage Configuration (Staging)
# ===========================================
# ตั้ง STORAGE_PROVIDER=r2 เพื่อเปิดใช้งาน Cloudflare R2 (หรือตั้งเป็น local เพื่อเก็บในเครื่อง VPS)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
# Optional: Public Custom Domain หรือ r2.dev URL (ถ้าไม่ระบุ ระบบจะเสิร์ฟรูปผ่าน /uploads/... ของ Next.js แทน)
R2_PUBLIC_URL=
# แยกโฟลเดอร์ของ Staging ใน Bucket ไม่ให้ปะปนกับ Production
R2_KEY_PREFIX=staging

# ===========================================
# Node Environment
# ===========================================
NODE_ENV=production
