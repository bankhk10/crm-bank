# ===========================================
# Docker Ignore File
# ===========================================

# Dependencies
node_modules
.pnpm-store

# Build outputs
.next
out
build
dist

# Git
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo

# Environment files (will be injected at runtime)
.env
.env.*
!.env.production.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Test files
coverage
.nyc_output
*.test.js
*.test.ts
*.spec.js
*.spec.ts
__tests__

# Documentation
docs
*.md
!README.md

# Misc
.DS_Store
*.pem
Thumbs.db

# Backup files
backups
*.backup
*.bak

# Development files
tsconfig.tsbuildinfo
.eslintcache

# Gemini/Agent files
.gemini
.agent

# TypeScript build info
*.tsbuildinfo

# Docker files (no need to copy into image)
Dockerfile*
docker-compose*.yml
