# ===========================================
# Production Environment Configuration
# ===========================================
# Copy this file to .env.production and fill in the values
# IMPORTANT: Never commit .env.production to version control!
# 
# สำหรับ Server: Ubuntu 24.04.3 LTS
# Domain: csone.cropsciences.co.th
# IP: 27.254.143.48

# ===========================================
# PostgreSQL Database Configuration
# ===========================================
POSTGRES_USER=crm_admin
POSTGRES_PASSWORD=secret
POSTGRES_DB=crm_bank

# Database URL (used by Prisma) - ใช้สำหรับ local development
# สำหรับ Docker จะถูกสร้างอัตโนมัติจาก POSTGRES_* variables
DATABASE_URL=postgresql://crm_admin:secret@postgres:5432/crm_bank

# ===========================================
# Authentication Configuration
# ===========================================
# Generate with: openssl rand -base64 64
AUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64
AUTH_TRUST_HOST=true

# Application URL (your domain)
NEXTAUTH_URL=https://csone.cropsciences.co.th

# ===========================================
# Feature Flags
# ===========================================
NEXT_PUBLIC_SHOW_RANDOM_FILL=false
# Activity Plan Testing Mode: set to true to allow recording actuals without approval during testing
ACTIVITY_PLAN_TEST_MODE=false

# ===========================================
# Node Environment
# ===========================================
NODE_ENV=production

# ===========================================
# Optional: Backup Configuration
# ===========================================
# BACKUP_RETENTION_DAYS=30
# BACKUP_S3_BUCKET=your-backup-bucket

# ===========================================
# Optional: Monitoring
# ===========================================
# SENTRY_DSN=your-sentry-dsn
# PROMETHEUS_ENABLED=true
